# A recursive step's lookups give the columns read above the join and by
# their own condition (`tr.w`, past the keys).
statement ok
CREATE TABLE tr (id int PRIMARY KEY, parent int, w int)

statement ok
INSERT INTO tr SELECT i, i / 2, i % 5 FROM generate_series(1, 20000) i

statement ok
CREATE INDEX tr_parent ON tr (parent)

statement ok
ANALYZE tr

query III
WITH RECURSIVE d(id, depth) AS (SELECT 10, 0 UNION ALL SELECT tr.id, d.depth + 1 FROM tr JOIN d ON tr.parent = d.id) SELECT count(*), sum(id), max(depth) FROM d
----
2047 14679037 10

query III
WITH RECURSIVE d(id, depth) AS (SELECT 10, 0 UNION ALL SELECT tr.id, d.depth + 1 FROM tr JOIN d ON tr.parent = d.id AND tr.w <> d.depth % 5) SELECT count(*), sum(id), max(depth) FROM d
----
174 1002713 10
