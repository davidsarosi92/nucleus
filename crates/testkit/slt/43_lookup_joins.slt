# Index nested loops (PLAN.md §M14.20 V10): a join whose right side is a
# table read by an index on the join keys, for few left rows, looks each
# left row's matches up instead of hashing the table — inner, left, semi
# and anti joins, inside a correlated subquery too (results checked
# against PostgreSQL 18).

statement ok
CREATE TABLE lb (id INT PRIMARY KEY, g INT, v INT)

statement ok
CREATE TABLE ls (k INT PRIMARY KEY, ref INT, w INT)

statement ok
INSERT INTO lb SELECT i, i % 97, i * 7 % 1000 FROM generate_series(1, 20000) i

statement ok
INSERT INTO ls VALUES (1, 5, 10), (2, 17, 20), (3, 20001, 30), (4, NULL, 40), (5, 19999, 50)

statement ok
CREATE INDEX lb_g ON lb (g)

statement ok
ANALYZE

query T
EXPLAIN SELECT ls.k, lb.v FROM ls JOIN lb ON lb.id = ls.ref
----
Project: #0, #1
  Project: #1, #0
    Project: #3, #0
      Index Nested Loop on (#2 = #1)
        Project: #0, #1
          Seq Scan on ls (rows=5)
        Project: #0, #2
          Index Scan using primary key on lb (id = outer1.#1) filter: (#0 = outer1.#1) (rows=1)

query II
SELECT ls.k, lb.v FROM ls JOIN lb ON lb.id = ls.ref ORDER BY 1
----
1 35
2 119
5 993

query II
SELECT ls.k, lb.v FROM ls LEFT JOIN lb ON lb.id = ls.ref ORDER BY 1
----
1 35
2 119
3 NULL
4 NULL
5 993

query I
SELECT count(*) FROM ls WHERE EXISTS (SELECT 1 FROM lb WHERE lb.id = ls.ref AND lb.v > 100)
----
2

query I
SELECT count(*) FROM ls WHERE NOT EXISTS (SELECT 1 FROM lb WHERE lb.id = ls.ref)
----
2

query III
SELECT ls.k, count(*), sum(lb.v) FROM ls JOIN lb ON lb.g = ls.k GROUP BY ls.k ORDER BY 1
----
1 207 102408
2 207 101857
3 207 103306
4 207 101755
5 207 103204

query II
SELECT ls.k, (SELECT sum(lb.v) FROM ls s2 JOIN lb ON lb.id = s2.ref WHERE s2.w <= ls.w AND lb.v > ls.w) FROM ls ORDER BY 1
----
1 35
2 154
3 154
4 119
5 1112

# A lookup inside a correlated subquery whose outer query has a join: the
# lookup's right side reads its left row (one level) and the outer row (two),
# and both stay right when the outer plan's rows are narrowed.
query III
SELECT a.k, b.w, (SELECT sum(lb.v) FROM ls s2 JOIN lb ON lb.id = s2.ref AND lb.v > a.w WHERE s2.w <= b.w) FROM ls a JOIN ls b ON b.k = a.k ORDER BY 1
----
1 10 35
2 20 154
3 30 154
4 40 119
5 50 1112

# An OR across two tables implies a filter of each (the OR of each branch's
# conjuncts on it), pushed down beside it (checked against PostgreSQL 18).
query II
SELECT count(*), sum(lb.v) FROM ls, lb WHERE (lb.id = ls.ref AND ls.w = 10 AND lb.v > 0) OR (lb.id = ls.ref AND ls.w = 50 AND lb.v < 2000)
----
2 1028

query T
EXPLAIN SELECT count(*) FROM ls, lb WHERE (lb.id = ls.ref AND ls.w = 10 AND lb.v > 0) OR (lb.id = ls.ref AND ls.w = 50 AND lb.v < 2000)
----
Project: #0
  Aggregate: count(*)
    Project: #0
      Project: #0
        Index Nested Loop on ((#3 = #1) AND (((#2 = 10) AND (#4 > 0)) OR ((#2 = 50) AND (#4 < 2000))))
          Seq Scan on ls filter: ((#2 = 10) OR (#2 = 50)) (rows=2)
          Project: #0, #2
            Index Scan using primary key on lb (id = outer1.#1) filter: (((#2 > 0) OR (#2 < 2000)) AND (#0 = outer1.#1)) (rows=1)

# Semi and anti joins by lookup stop at a key's first match.
query I
SELECT count(*) FROM lb WHERE lb.g < 3 AND NOT EXISTS (SELECT 1 FROM ls WHERE ls.ref = lb.id)
----
620

query I
SELECT count(*) FROM ls WHERE EXISTS (SELECT 1 FROM lb WHERE lb.g = ls.k AND lb.v > 990)
----
3
