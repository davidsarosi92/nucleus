# An index's own columns too, where it holds their values: not an
# expression's (`upper(u)` holds 'U5', not 'u5'), nor of a type its key
# encoding changes.  A unique index's entries are keyed by its values
# alone, NULL's by the primary key too.
statement ok
CREATE TABLE qx (id int PRIMARY KEY, m numeric, ch char(3), r real, u text UNIQUE, v int)

statement ok
INSERT INTO qx SELECT i, i * 0.25 + 0.50, substr('abc', 1 + i % 3, 1 + i % 2), i * 0.1, CASE WHEN i % 1000 = 0 THEN NULL ELSE 'u' || i END, i % 3 FROM generate_series(1, 20000) i

statement ok
CREATE INDEX qx_m ON qx (m, ch, r)

statement ok
CREATE INDEX qx_up ON qx ((upper(u)))

statement ok
ANALYZE

