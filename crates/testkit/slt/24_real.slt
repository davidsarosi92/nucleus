# real (32-bit float) beside double precision: input, output (the shortest
# digits that read back, PostgreSQL's notation for each), ranges, arithmetic,
# casts, keys, aggregates.
# Expected results produced by PostgreSQL 18 (records marked nucleus-only
# excepted).

query TTTT
SELECT 0.1::real, 1.5::float4, '  -2.25 '::real, 1::real / 3::real
----
0.1 1.5 -2.25 0.33333334

query TTTT
SELECT 3.4e38::real, 1e-45::real, 123456789::real, 123456.7::real
----
3.4e+38 1e-45 1.2345679e+08 123456.7

query TTTT
SELECT 1e10::real, 1e-5::real, 0.0001::real, 12345678::real
----
1e+10 1e-05 0.0001 1.2345678e+07

query TTTT
SELECT 'NaN'::real, '-inf'::real, '+Infinity'::real, '-0'::real
----
NaN -Infinity Infinity -0

query TTTT
SELECT 1e16::float8, 1e15::float8, 123456789012345::float8, 1e-5::float8
----
1e+16 1e+15 123456789012345 1e-05

query TTT
SELECT -1.5e300::float8, '-0'::float8, 0.1::float8
----
-1.5e+300 -0 0.1

statement error 22003
SELECT '1e40'::real

statement error 22003
SELECT '1e-50'::real

statement error 22003
SELECT '1e400'::float8

statement error 22003
SELECT '1e-400'::float8

statement error 22P02
SELECT 'abc'::real

statement error 22003
SELECT 1e40::float8::real

statement error 22003
SELECT 1e-50::float8::real

# Arithmetic: real with real is computed in 32 bits; with anything else, as
# a double.

query TTT
SELECT 0.1::real + 0.2::real, 0.1::real + 0.2, 0.1::real::float8
----
0.3 0.30000000149011613 0.10000000149011612

query TT
SELECT 1 / 3::real, power(2::real, 0.5)
----
0.3333333333333333 1.4142135623730951

statement error 22003
SELECT 3.4e38::real * 10::real

statement error 22003
SELECT 1e-30::real * 1e-30::real

statement error 22003
SELECT 1e308::float8 * 10

statement error 22003
SELECT 1e-300::float8 * 1e-300

statement error 22012
SELECT 1::real / 0::real

query TT
SELECT 'inf'::real * 2::real, 'inf'::float8 - 1
----
Infinity Infinity

query BB
SELECT 0.1::real = 0.1::float8, 0.5::real = 0.5::float8
----
false true

# Casts.

query IIT
SELECT 2.5::real::integer, 3.5::real::smallint, 0.1::real::numeric
----
2 4 0.1

query TT
SELECT (1::real / 3::real)::numeric, 123456.7::real::numeric
----
0.333333 123457

query TT
SELECT round(2.5::float8), round(-2.5::float8)
----
2 -2

query TTT
SELECT round(2.5::real), trunc(2.7::real), abs(-1.5::real)
----
2 2 1.5

# Columns, keys and aggregates.

statement ok
CREATE TABLE r (x real PRIMARY KEY, d double precision)

statement ok
INSERT INTO r VALUES (1.5, 1.5), (0.1, 0.1), ('-inf', 0), ('NaN', 'NaN'), (-0.5, -0.5)

statement error 23505
INSERT INTO r VALUES (1.5, 2)

statement error 22003
INSERT INTO r VALUES (1e39, 0)

query TT
SELECT x, d FROM r ORDER BY x
----
-Infinity 0
-0.5 -0.5
0.1 0.1
1.5 1.5
NaN NaN

query T
SELECT x FROM r WHERE x = 1.5
----
1.5

query T
SELECT x FROM r WHERE x = 0.1
----

query T
SELECT x FROM r WHERE x = 0.1::real
----
0.1

query T
SELECT x FROM r WHERE x > 0 AND x < 2 ORDER BY x
----
0.1
1.5

query TT
SELECT sum(x), avg(x) FROM r WHERE x > -1 AND x < 2
----
1.1 0.36666666716337204

statement error 22003
SELECT sum(x) FROM (VALUES (3e38::real), (3e38::real)) v (x)

query TT
SELECT min(x), max(x) FROM r WHERE x < 'NaN'
----
-Infinity 1.5

query T
SELECT ARRAY[1.5::real, 0.1::real]
----
{1.5,0.1}

query T
SELECT CASE WHEN true THEN 1::real ELSE 2 END
----
1

statement ok
DROP TABLE r
