# serial and identity columns (issue #23, second step): serial,
# bigserial, smallserial; GENERATED {ALWAYS | BY DEFAULT} AS IDENTITY;
# OVERRIDING SYSTEM / USER VALUE; DEFAULT in VALUES and UPDATE SET; a
# sequence OWNED BY a column dropped with it; pg_get_serial_sequence;
# TRUNCATE … RESTART IDENTITY.  Checked against PostgreSQL 18 in one
# session (scripts/slt-pg.py --session).

statement ok
CREATE TABLE s1 (id serial PRIMARY KEY, b bigserial, sm smallserial, v text)

statement ok
INSERT INTO s1 (v) VALUES ('a'), ('b')

query IIIT
SELECT id, b, sm, v FROM s1 ORDER BY id
----
1 1 1 a
2 2 2 b

# A value given is taken (serial is a default)
statement ok
INSERT INTO s1 (id, v) VALUES (10, 'c')

query IT
SELECT id, v FROM s1 ORDER BY id
----
1 a
2 b
10 c

# The sequences serial made, owned by their columns
query T
SELECT pg_get_serial_sequence('s1', 'id')
----
public.s1_id_seq

query T
SELECT pg_get_serial_sequence('s1', 'b')
----
public.s1_b_seq

query T
SELECT pg_get_serial_sequence('s1', 'v')
----
NULL

query I
SELECT currval('s1_id_seq')
----
2

# serial is NOT NULL
statement error 23502
INSERT INTO s1 (id, v) VALUES (NULL, 'd')

# DEFAULT in VALUES: the column's default (NULL without one)
statement ok
INSERT INTO s1 VALUES (DEFAULT, DEFAULT, DEFAULT, DEFAULT)

query IT
SELECT id, v FROM s1 WHERE id = 3
----
3 NULL

statement ok
INSERT INTO s1 (v, id) VALUES ('e', DEFAULT), ('f', 20)

query IT
SELECT id, v FROM s1 WHERE v IN ('e', 'f') ORDER BY id
----
4 e
20 f

# DEFAULT in UPDATE SET
statement ok
UPDATE s1 SET v = DEFAULT, sm = DEFAULT WHERE id = 20

query IIT
SELECT id, sm, v FROM s1 WHERE id = 20
----
20 8 NULL

# Its sequence goes with the table
statement ok
DROP TABLE s1

statement error 42P01
SELECT nextval('s1_id_seq')

# A name taken: the next free one
statement ok
CREATE SEQUENCE s2_id_seq

statement ok
CREATE TABLE s2 (id serial, v int)

query T
SELECT pg_get_serial_sequence('s2', 'id')
----
public.s2_id_seq1

statement ok
INSERT INTO s2 (v) VALUES (1)

query II
SELECT id, v FROM s2
----
1 1

# A sequence a serial owns: dropped with its default only by CASCADE
statement error 2BP01
DROP SEQUENCE s2_id_seq1

statement ok
DROP SEQUENCE s2_id_seq1 CASCADE

statement error 23502
INSERT INTO s2 (v) VALUES (2)

statement ok
DROP TABLE s2

statement ok
DROP SEQUENCE s2_id_seq

# Identity: ALWAYS
statement ok
CREATE TABLE a1 (id int GENERATED ALWAYS AS IDENTITY PRIMARY KEY, v text)

statement ok
INSERT INTO a1 (v) VALUES ('a'), ('b')

query IT
SELECT id, v FROM a1 ORDER BY id
----
1 a
2 b

statement error 428C9
INSERT INTO a1 (id, v) VALUES (5, 'c')

statement error 428C9
INSERT INTO a1 VALUES (5, 'c')

# DEFAULT is not a value given
statement ok
INSERT INTO a1 VALUES (DEFAULT, 'c')

statement ok
INSERT INTO a1 OVERRIDING SYSTEM VALUE VALUES (100, 'd')

statement ok
INSERT INTO a1 (id, v) OVERRIDING USER VALUE VALUES (5, 'e')

query IT
SELECT id, v FROM a1 ORDER BY id
----
1 a
2 b
3 c
4 e
100 d

statement error 428C9
INSERT INTO a1 (id, v) SELECT 7, 'f'

statement ok
INSERT INTO a1 (id, v) OVERRIDING USER VALUE SELECT 7, 'g'

query IT
SELECT id, v FROM a1 WHERE v = 'g'
----
5 g

statement error 428C9
UPDATE a1 SET id = 50 WHERE v = 'a'

statement ok
UPDATE a1 SET id = DEFAULT WHERE v = 'a'

query IT
SELECT id, v FROM a1 WHERE v = 'a'
----
6 a

# Identity is NOT NULL
statement error 23502
INSERT INTO a1 OVERRIDING SYSTEM VALUE VALUES (NULL, 'h')

query T
SELECT pg_get_serial_sequence('a1', 'id')
----
public.a1_id_seq

# Its sequence is the column's: not dropped alone
statement error 2BP01
DROP SEQUENCE a1_id_seq

statement error 2BP01
DROP SEQUENCE a1_id_seq CASCADE

# Its default is its sequence's
statement error 42601
ALTER TABLE a1 ALTER COLUMN id SET DEFAULT 5

statement error 42601
ALTER TABLE a1 ALTER COLUMN id DROP DEFAULT

# Its sequence renamed: still its
statement ok
ALTER SEQUENCE a1_id_seq RENAME TO a1_seq

statement ok
INSERT INTO a1 (v) VALUES ('i')

query T
SELECT pg_get_serial_sequence('a1', 'id')
----
public.a1_seq

# An upsert's SET: DEFAULT, nothing else
query IT
INSERT INTO a1 OVERRIDING SYSTEM VALUE VALUES (2, 'j') ON CONFLICT (id) DO UPDATE SET v = 'u', id = DEFAULT RETURNING id, v
----
8 u

statement error 428C9
INSERT INTO a1 (v) VALUES ('k') ON CONFLICT (id) DO UPDATE SET id = 7

# nucleus-only: its definition
query T
SELECT definition FROM nc_catalog.definitions WHERE kind = 'table' AND name = 'a1'
----
CREATE TABLE a1 (id integer GENERATED ALWAYS AS IDENTITY (SEQUENCE NAME a1_seq), v text, CONSTRAINT a1_pkey PRIMARY KEY (id))

# Identity: BY DEFAULT, with options
statement ok
CREATE TABLE d1 (id bigint GENERATED BY DEFAULT AS IDENTITY (START WITH 100 INCREMENT BY 10), v text)

statement ok
INSERT INTO d1 (v) VALUES ('a'), ('b')

statement ok
INSERT INTO d1 VALUES (1, 'c')

statement ok
INSERT INTO d1 OVERRIDING USER VALUE VALUES (2, 'd')

query IT
SELECT id, v FROM d1 ORDER BY v
----
100 a
110 b
1 c
120 d

statement ok
UPDATE d1 SET id = 3 WHERE v = 'c'

query IT
SELECT id, v FROM d1 WHERE v = 'c'
----
3 c

# TRUNCATE … RESTART IDENTITY
statement ok
TRUNCATE d1 RESTART IDENTITY

statement ok
INSERT INTO d1 (v) VALUES ('x')

query IT
SELECT id, v FROM d1
----
100 x

statement ok
TRUNCATE d1

statement ok
INSERT INTO d1 (v) VALUES ('y')

query IT
SELECT id, v FROM d1
----
110 y

# Identity of a type not an integer's
statement error 22023
CREATE TABLE bad1 (id text GENERATED ALWAYS AS IDENTITY)

# A default and an identity
statement error 42601
CREATE TABLE bad2 (id int DEFAULT 1 GENERATED ALWAYS AS IDENTITY)

# Its sequence's type: the column's
statement ok
CREATE TABLE sm1 (id smallint GENERATED ALWAYS AS IDENTITY (MAXVALUE 2), v int)

statement ok
INSERT INTO sm1 (v) VALUES (1), (2)

statement error 2200H
INSERT INTO sm1 (v) VALUES (3)

# A renamed table and column: the sequence follows
statement ok
ALTER TABLE d1 RENAME TO d2

statement ok
ALTER TABLE d2 RENAME COLUMN id TO key

query T
SELECT pg_get_serial_sequence('d2', 'key')
----
public.d1_id_seq

statement ok
INSERT INTO d2 (v) VALUES ('z')

query I
SELECT count(*) FROM d2
----
2

# A column dropped: its sequence too
statement ok
ALTER TABLE d2 DROP COLUMN key

statement error 42P01
SELECT nextval('d1_id_seq')

# A serial column added: each row its own value
statement ok
CREATE TABLE ad (v text)

statement ok
INSERT INTO ad VALUES ('a'), ('b'), ('c')

statement ok
ALTER TABLE ad ADD COLUMN id serial

query IT
SELECT id, v FROM ad ORDER BY id
----
1 a
2 b
3 c

statement ok
ALTER TABLE ad ADD COLUMN gid int GENERATED ALWAYS AS IDENTITY

query I
SELECT count(DISTINCT gid) FROM ad
----
3

# nucleus-only: definitions, an identity's options in its parentheses
query T
SELECT definition FROM nc_catalog.definitions WHERE name IN ('sm1', 'ad', 'ad_id_seq') ORDER BY kind, name
----
ALTER SEQUENCE ad_id_seq OWNED BY ad.id
CREATE SEQUENCE ad_id_seq AS integer
CREATE TABLE ad (v text, id integer NOT NULL DEFAULT nextval('ad_id_seq'), gid integer GENERATED ALWAYS AS IDENTITY (SEQUENCE NAME ad_gid_seq))
CREATE TABLE sm1 (id smallint GENERATED ALWAYS AS IDENTITY (SEQUENCE NAME sm1_id_seq MAXVALUE 2), v integer)

statement ok
DROP TABLE a1, d2, sm1, ad
