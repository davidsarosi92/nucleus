# Scalar, EXISTS and IN subqueries, correlated and not; FROM subqueries; UNION.

statement ok
CREATE TABLE t (id INT PRIMARY KEY, grp INT, v INT)

statement ok
INSERT INTO t VALUES (1, 1, 10), (2, 1, 20), (3, 2, 5), (4, 3, NULL)

query I
SELECT (SELECT max(v) FROM t)
----
20

query I rowsort
SELECT id FROM t WHERE v > (SELECT avg(v) FROM t)
----
2

# Correlated: rows above their group's average.
query I
SELECT id FROM t a WHERE v > (SELECT avg(v) FROM t b WHERE b.grp = a.grp) ORDER BY id
----
2

query I rowsort
SELECT id FROM t a WHERE EXISTS (SELECT 1 FROM t b WHERE b.grp = a.grp AND b.id <> a.id)
----
1
2

query I rowsort
SELECT id FROM t WHERE grp IN (SELECT grp FROM t WHERE v >= 20)
----
1
2

query I rowsort
SELECT id FROM t WHERE grp NOT IN (SELECT grp FROM t WHERE v IS NOT NULL)
----
4

# NOT IN with a NULL in the list is never true.
query I
SELECT count(*) FROM t WHERE 99 NOT IN (SELECT v FROM t)
----
0

query II
SELECT g, n FROM (SELECT grp AS g, count(*) AS n FROM t GROUP BY grp) s WHERE n > 1
----
1 2

statement error 21000
SELECT (SELECT v FROM t)

query I
SELECT (SELECT v FROM t WHERE id = 99)
----
NULL

query I
SELECT id FROM t UNION SELECT grp FROM t ORDER BY 1
----
1
2
3
4

query I
SELECT grp FROM t UNION ALL SELECT grp FROM t WHERE grp > 1 ORDER BY 1
----
1
1
2
2
3
3

query IT
VALUES (2, 'b'), (1, 'a') ORDER BY 1
----
1 a
2 b

query IT
SELECT * FROM (VALUES (1, 'x'), (2, 'y')) AS v WHERE column1 > 1
----
2 y

# A correlated subquery in a join's WHERE reading both sides: it stays
# where both are (not pushed into one side's scan), and its references
# follow the rows when joins are reordered.
statement ok
CREATE TABLE ca (x INT PRIMARY KEY, y INT)

statement ok
CREATE TABLE cb (k INT PRIMARY KEY, z INT)

statement ok
INSERT INTO ca VALUES (1, 10), (2, 20), (3, 30)

statement ok
INSERT INTO cb VALUES (1, 1), (2, 2), (3, 3)

query I
SELECT count(*) FROM ca, cb WHERE cb.k = ca.x AND ca.y < (SELECT 2 * avg(a2.y) FROM ca a2 WHERE a2.x = cb.k)
----
3

query I
SELECT count(*) FROM cb, ca WHERE cb.k = ca.x AND cb.z < (SELECT max(a2.y) FROM ca a2 WHERE a2.x = ca.x + 1)
----
2

query II
SELECT cb.k, (SELECT a2.y FROM ca a2 WHERE a2.x = cb.k) FROM ca, cb WHERE ca.x = cb.k AND (SELECT a3.y FROM ca a3 WHERE a3.x = cb.z) > 15 ORDER BY 1
----
2 20
3 30

query I
SELECT count(*) FROM ca WHERE EXISTS (SELECT 1 FROM cb WHERE cb.k = ca.x AND cb.z <> (SELECT min(z) FROM cb c2 WHERE c2.k >= ca.x))
----
0

statement ok
ANALYZE

query I
SELECT count(*) FROM ca, cb, ca a3 WHERE cb.k = ca.x AND a3.x = cb.z AND ca.y < (SELECT 2 * avg(a2.y) FROM ca a2 WHERE a2.x = cb.k AND a2.y = a3.y)
----
3

# EXISTS, NOT EXISTS and IN unnested into semi and anti joins: the results
# of the subqueries (checked against PostgreSQL 18), NULL keys included.
statement ok
CREATE TABLE so (ok INT PRIMARY KEY, ck INT, d DATE)

statement ok
CREATE TABLE sl (ok INT, ln INT, s INT, cd DATE, rd DATE, PRIMARY KEY (ok, ln))

statement ok
INSERT INTO so SELECT i, i % 10, date '2020-01-01' + i FROM generate_series(1, 100) i

statement ok
INSERT INTO sl SELECT i % 50 + 1, i, i % 7, date '2020-01-01' + i % 9, date '2020-01-01' + i % 5 FROM generate_series(1, 300) i

statement ok
INSERT INTO so VALUES (1000, NULL, NULL)

query I
SELECT count(*) FROM so WHERE d > date '1990-01-01' AND EXISTS (SELECT * FROM sl WHERE sl.ok = so.ok AND cd < rd)
----
35

query I
SELECT count(*) FROM sl l1 WHERE NOT EXISTS (SELECT * FROM sl l3 WHERE l3.ok = l1.ok AND l3.s <> l1.s AND l3.rd > l3.cd)
----
103

query I
SELECT count(*) FROM so WHERE ok IN (SELECT ok FROM sl WHERE s > 3)
----
50

query I
SELECT count(*) FROM so WHERE NOT EXISTS (SELECT 1 FROM sl WHERE sl.s = so.ck)
----
31

query I
SELECT count(*) FROM so WHERE ck IN (SELECT s FROM sl WHERE sl.ok = so.ok)
----
28

query I
SELECT count(*) FROM so WHERE ok IN (SELECT DISTINCT ok FROM sl ORDER BY ok) AND NOT EXISTS (SELECT 1 FROM sl WHERE sl.ok = so.ok AND sl.s = 6)
----
7

query T
EXPLAIN SELECT count(*) FROM so WHERE EXISTS (SELECT * FROM sl WHERE sl.ok = so.ok AND cd < rd)
----
Project: #0
  Aggregate: count(*)
    Semi Hash Join (#0 = #0) on (#1 = #0)
      Project: #0
        Seq Scan on so
      Project: #0
        Seq Scan on sl filter: (#3 < #4)

# A semi or anti join goes below the joins to the table its condition
# reads (checked against PostgreSQL 18).
query II
SELECT count(*), sum(sl.s) FROM so, sl WHERE so.ok = sl.ok AND so.ok IN (SELECT ok FROM sl WHERE s = 6) AND NOT EXISTS (SELECT 1 FROM sl s2 WHERE s2.ok = sl.ok AND s2.ln = sl.ln + 1)
----
258 798

query I
SELECT count(*) FROM so a, so b WHERE a.ck = b.ck AND b.ok IN (SELECT ok FROM sl WHERE s > 4) AND EXISTS (SELECT 1 FROM sl WHERE sl.ok = a.ok AND sl.s = 0)
----
210

query T
EXPLAIN SELECT count(*) FROM so a, so b WHERE a.ck = b.ck AND b.ok IN (SELECT ok FROM sl WHERE s > 4)
----
Project: #0
  Aggregate: count(*)
    Hash Join (#0 = #0) on (#0 = #1)
      Project: #1
        Seq Scan on so
      Project: #1
        Semi Hash Join (#0 = #0) on (#0 = #2)
          Project: #0, #1
            Seq Scan on so
          Project: #0
            Seq Scan on sl filter: (#2 > 4)
