# A generated graph: 100 nodes, 250 edges.

statement ok
CREATE TABLE node (id int PRIMARY KEY, grp int)

statement ok
INSERT INTO node SELECT g, g % 7 FROM generate_series(0, 99) g

statement ok
CREATE TABLE edge (id int PRIMARY KEY, src int REFERENCES node, dst int REFERENCES node, w int)

statement ok
INSERT INTO edge SELECT g, g % 100, (g * 37 + 11) % 100, g % 5 + 1 FROM generate_series(0, 249) g

# nucleus-only: SQL/PGQ
statement ok
CREATE PROPERTY GRAPH gen VERTEX TABLES (node) EDGE TABLES (edge SOURCE KEY (src) REFERENCES node (id) DESTINATION KEY (dst) REFERENCES node (id))

# nucleus-only: = SELECT count(*), sum(a.id), sum(c.id) FROM node a JOIN
# edge e ON e.src = a.id JOIN node b ON b.id = e.dst JOIN edge f ON
# f.src = b.id JOIN node c ON c.id = f.dst WHERE a.grp = c.grp
query III
SELECT count(*), sum(a), sum(c) FROM GRAPH_TABLE (gen MATCH (a)-[e]->(b)-[f]->(c) WHERE a.grp = c.grp COLUMNS (a.id AS a, c.id AS c))
----
75 3359 3821

# nucleus-only: = SELECT count(*), sum(b.id) FROM node a JOIN edge e ON
# e.src = a.id OR e.dst = a.id JOIN node b ON (e.src = a.id AND e.dst =
# b.id) OR (e.dst = a.id AND e.src = b.id) WHERE a.id < 10
query II
SELECT count(*), sum(b) FROM GRAPH_TABLE (gen MATCH (a WHERE a.id < 10)-[e]-(b) COLUMNS (b.id AS b))
----
54 2637

# nucleus-only: = WITH RECURSIVE r (s, e, len) AS (SELECT src, dst, 1 FROM
# edge WHERE w > 1 AND src < 5 UNION ALL SELECT r.s, x.dst, r.len + 1
# FROM r JOIN edge x ON x.src = r.e WHERE x.w > 1 AND r.len < 4) SELECT
# count(*), sum(len), sum(e) FROM r
query III
SELECT count(*), sum(n), sum(b) FROM GRAPH_TABLE (gen MATCH p = (a WHERE a.id < 5)-[e WHERE e.w > 1]->{1,4}(b) COLUMNS (path_length(p) AS n, b.id AS b))
----
90 246 3918

# nucleus-only: = WITH RECURSIVE r (s, e, len) AS (SELECT src, dst, 1 FROM
# edge UNION SELECT r.s, x.dst, r.len + 1 FROM r JOIN edge x ON x.src =
# r.e WHERE r.len < 30) SELECT count(*), sum(m), max(m) FROM (SELECT s, e,
# min(len) m FROM r GROUP BY s, e) t
query III
SELECT count(*), sum(n), max(n) FROM GRAPH_TABLE (gen MATCH p = ANY SHORTEST (a)-[e]->+(b) COLUMNS (path_length(p) AS n))
----
1680 17000 20

# nucleus-only: = the same, min(len) of the rows WHERE len >= 2
query III
SELECT count(*), sum(n), max(n) FROM GRAPH_TABLE (gen MATCH p = ANY SHORTEST (a)-[e]->{2,}(b) COLUMNS (path_length(p) AS n))
----
1680 18680 21

# nucleus-only: = WITH RECURSIVE x (s, d) AS (SELECT src, dst FROM edge
# UNION ALL SELECT dst, src FROM edge), r (s, e, len) AS (SELECT 0, 0, 0
# UNION SELECT r.s, x.d, r.len + 1 FROM r JOIN x ON x.s = r.e WHERE r.len
# < 30) SELECT count(*), sum(m), max(m) FROM (SELECT s, e, min(len) m FROM
# r GROUP BY s, e) t
query III
SELECT count(*), sum(n), max(n) FROM GRAPH_TABLE (gen MATCH p = ANY SHORTEST (a WHERE a.id = 0)-[e]-*(b) COLUMNS (path_length(p) AS n))
----
20 100 10

# nucleus-only: = WITH RECURSIVE r (s, e, len) AS (SELECT dst, src, 1 FROM
# edge UNION SELECT r.s, x.src, r.len + 1 FROM r JOIN edge x ON x.dst =
# r.e WHERE r.len < 3) SELECT count(*), sum(m) FROM (SELECT s, e, min(len)
# m FROM r GROUP BY s, e) t JOIN node a ON a.id = t.s JOIN node b ON b.id
# = t.e WHERE a.grp = b.grp
query II
SELECT count(*), sum(n) FROM GRAPH_TABLE (gen MATCH p = ANY SHORTEST (a)<-[e]-{1,3}(b) WHERE a.grp = b.grp COLUMNS (path_length(p) AS n))
----
43 85

