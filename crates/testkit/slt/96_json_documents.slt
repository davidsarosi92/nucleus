# delete by a filter; count
statement ok
DELETE FROM inv WHERE doc @? json_filter('{"status": "D"}')

query I
SELECT count(*) FROM inv WHERE doc @? json_filter('{"qty": {"$gt": 20}}')
----
3

# an upsert's document: the filter's equalities, then the update ($setOnInsert too)
query T
SELECT json_upsert_document('{"item": "pen", "qty": {"$gt": 1}, "size.uom": {"$eq": "mm"}}', '{"$set": {"qty": 5}, "$setOnInsert": {"tags": []}}')
----
{"qty": 5, "item": "pen", "size": {"uom": "mm"}, "tags": []}

# inserted when nothing matches (the _id made by the collection), not again
statement ok
INSERT INTO inv (doc) SELECT json_upsert_document('{"item": "pen", "qty": {"$gt": 1}, "size.uom": {"$eq": "mm"}}', '{"$set": {"qty": 5}, "$setOnInsert": {"tags": []}}') WHERE NOT EXISTS (SELECT 1 FROM inv WHERE doc @? json_filter('{"item": "pen", "qty": {"$gt": 1}, "size.uom": {"$eq": "mm"}}'))

statement ok
INSERT INTO inv (doc) SELECT json_upsert_document('{"item": "pen", "qty": {"$gt": 1}, "size.uom": {"$eq": "mm"}}', '{"$set": {"qty": 5}, "$setOnInsert": {"tags": []}}') WHERE NOT EXISTS (SELECT 1 FROM inv WHERE doc @? json_filter('{"item": "pen", "qty": {"$gt": 1}, "size.uom": {"$eq": "mm"}}'))

query T
SELECT doc - '_id' FROM inv WHERE doc @? json_filter('{"item": "pen"}')
----
{"qty": 5, "item": "pen", "size": {"uom": "mm"}, "tags": []}

# A sort document's fields in its text's order (a json object's keys are
# unordered), or as [field, 1 or -1] pairs
query T
SELECT string_agg(i::text, ',' ORDER BY json_sort_key(d::json, '{"t": 1, "i": -1}')) FROM (VALUES (1, '{"t": [2], "i": 1}'), (2, '{"t": [1, 5], "i": 2}'), (3, '{"t": 2, "i": 3}')) v(i, d)
----
2,3,1

query T
SELECT string_agg(i::text, ',' ORDER BY json_sort_key(d::json, '[["t", 1], ["i", -1]]')) FROM (VALUES (1, '{"t": [2], "i": 1}'), (2, '{"t": [1, 5], "i": 2}'), (3, '{"t": 2, "i": 3}')) v(i, d)
----
2,3,1

# Two sort fields through different arrays of a document: MongoDB's
# parallel arrays; through the same array, one key per element
statement error 22023
SELECT json_sort_key('{"a": [1], "b": [2]}', '{"a": 1, "b": 1}')

query B
SELECT json_sort_key('{"a": [{"x": 1, "y": 9}, {"x": 2, "y": 0}]}', '{"a.x": 1, "a.y": 1}') < json_sort_key('{"a": [{"x": 1, "y": 5}]}', '{"a.x": 1, "a.y": 1}')
----
false

statement error 22023
SELECT json_sort_key('{}', '{}')

statement error 22023
SELECT json_sort_key('{}', '{"a": 2}')

# Errors: an unknown operator, operators and fields mixed, a conflict, the
# _id changed, an operator on a value of another type
statement error 22023
SELECT json_update('{"a": 1}', '{"$sett": {"a": 2}}')

statement error 22023
SELECT json_update('{"a": 1}', '{"$set": {"a": 2}, "b": 1}')

statement error 22023
SELECT json_update('{"a": {"b": 1}}', '{"$set": {"a": 2}, "$inc": {"a.b": 1}}')

statement error 22023
SELECT json_update('{"_id": 1}', '{"$set": {"_id": 2}}')

statement error 22023
SELECT json_update('{"_id": 1}', '{"_id": 2, "a": 1}')

statement error 22023
SELECT json_update('{"a": "x"}', '{"$inc": {"a": 1}}')

statement error 22023
SELECT json_update('{"a": "x"}', '{"$set": {"a.b": 1}}')

statement error 22023
SELECT json_update('{"a": [1]}', '{"$pull": {"a.b": 1}}')

statement error 22023
SELECT json_update('{"a": 1}', '{}')

# Not supported: positional paths, $currentDate, $bit, a $push $sort by
# several fields (a json object's keys are unordered)
statement error 0A000
SELECT json_update('{"a": [1]}', '{"$set": {"a.$": 2}}')

statement error 0A000
SELECT json_update('{"a": 1}', '{"$currentDate": {"a": true}}')

statement error 0A000
SELECT json_update('{"a": []}', '{"$push": {"a": {"$each": [{"x": 1}], "$sort": {"x": 1, "y": 1}}}}')

statement error 0A000
SELECT json_project('{"a": [1]}', '{"a": {"$elemMatch": {"$gt": 0}}}')

statement error 22023
SELECT json_project('{"a": 1, "b": 2}', '{"a": 1, "b": 0}')

# An upsert's filter setting a path twice
statement error 22023
SELECT json_upsert_document('{"a": 1, "a.b": 2}', '{"$set": {"c": 1}}')

# NULL in, NULL out
query T
SELECT json_update(NULL, '{"$set": {"a": 1}}') IS NULL AND json_project('{}', NULL) IS NULL AND json_sort_key(NULL, '{"a": 1}') IS NULL
----
t

# $setOnInsert holds only on an insert; numbers stay exact
query T
SELECT json_update('{"a": 0.1}', '{"$inc": {"a": 0.2}, "$setOnInsert": {"b": 1}}')
----
{"a": 0.3}
