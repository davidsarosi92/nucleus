# Reads and writes by filter (PLAN.md §M16 Q3, D22): find's projection
# (json_project), sort (json_sort_key), skip and limit; update documents
# (json_update), upserts (json_upsert_document); delete.  nucleus-only;
# every expected answer is MongoDB 8's on the same documents (written by
# a generator that ran both).

statement ok
CREATE COLLECTION inv

statement ok
INSERT INTO inv (doc) VALUES ('{"_id": 1, "item": "journal", "qty": 25, "tags": ["blank", "red"], "size": {"h": 14, "w": 21}, "status": "A"}'), ('{"_id": 2, "item": "notebook", "qty": 50, "tags": ["red", "blank"], "size": {"h": 8.5, "w": 11}, "status": "A"}'), ('{"_id": 3, "item": "paper", "qty": 100, "tags": ["red", "blank", "plain"], "size": {"h": 8.5, "w": 11}, "status": "D"}'), ('{"_id": 4, "item": "planner", "qty": 75, "tags": ["blank", "red"], "size": {"h": 22.85, "w": 30}, "status": "D"}'), ('{"_id": 5, "item": "postcard", "qty": 45, "tags": ["blue"], "size": {"h": 10, "w": 15.25}, "status": "A"}'), ('{"_id": 6, "item": "misc", "qty": "many", "tags": [], "status": null}'), ('{"_id": 7, "item": "box", "sizes": [{"h": 1}, {"h": 5, "w": 2}]}')

# a filter, a projection, a sort: MongoDB's find
query T
SELECT json_project(doc, '{"item": 1, "_id": 0}') FROM inv WHERE doc @? json_filter('{"status": "A"}') ORDER BY json_sort_key(doc, '{"qty": -1}')
----
{"item": "notebook"}
{"item": "postcard"}
{"item": "journal"}

# values of different types in MongoDB's order: null or missing, numbers, strings
query T
SELECT json_project(doc, '{"qty": 1}') FROM inv WHERE doc @? json_filter('{}') ORDER BY json_sort_key(doc, '{"qty": 1, "_id": 1}')
----
{"_id": 7}
{"_id": 1, "qty": 25}
{"_id": 5, "qty": 45}
{"_id": 2, "qty": 50}
{"_id": 4, "qty": 75}
{"_id": 3, "qty": 100}
{"_id": 6, "qty": "many"}

# an array by its least element ascending (an empty array first)
query T
SELECT json_project(doc, '{"tags": 1}') FROM inv WHERE doc @? json_filter('{}') ORDER BY json_sort_key(doc, '{"tags": 1, "_id": 1}')
----
{"_id": 6, "tags": []}
{"_id": 7}
{"_id": 1, "tags": ["blank", "red"]}
{"_id": 2, "tags": ["red", "blank"]}
{"_id": 3, "tags": ["red", "blank", "plain"]}
{"_id": 4, "tags": ["blank", "red"]}
{"_id": 5, "tags": ["blue"]}

# an array by its greatest element descending
query T
SELECT json_project(doc, '{"tags": 1}') FROM inv WHERE doc @? json_filter('{}') ORDER BY json_sort_key(doc, '{"tags": -1, "_id": 1}')
----
{"_id": 1, "tags": ["blank", "red"]}
{"_id": 2, "tags": ["red", "blank"]}
{"_id": 3, "tags": ["red", "blank", "plain"]}
{"_id": 4, "tags": ["blank", "red"]}
{"_id": 5, "tags": ["blue"]}
{"_id": 7}
{"_id": 6, "tags": []}

# a dotted path, a missing field as null
query T
SELECT json_project(doc, '{"size.h": 1}') FROM inv WHERE doc @? json_filter('{}') ORDER BY json_sort_key(doc, '{"size.h": 1, "_id": 1}')
----
{"_id": 6}
{"_id": 7}
{"_id": 2, "size": {"h": 8.5}}
{"_id": 3, "size": {"h": 8.5}}
{"_id": 5, "size": {"h": 10}}
{"_id": 1, "size": {"h": 14}}
{"_id": 4, "size": {"h": 22.85}}

# skip and limit after the sort
query T
SELECT json_project(doc, '{"_id": 1}') FROM inv WHERE doc @? json_filter('{}') ORDER BY json_sort_key(doc, '{"qty": -1, "_id": 1}') LIMIT 2 OFFSET 1
----
{"_id": 3}
{"_id": 4}

# through an array of objects
query T
SELECT json_project(doc, '{"sizes.h": 1}') FROM inv WHERE doc @? json_filter('{}') ORDER BY json_sort_key(doc, '{"sizes.h": -1, "_id": 1}')
----
{"_id": 7, "sizes": [{"h": 1}, {"h": 5}]}
{"_id": 1}
{"_id": 2}
{"_id": 3}
{"_id": 4}
{"_id": 5}
{"_id": 6}

# excluded fields; _id excluded too
query T
SELECT json_project(doc, '{"size": 0, "tags": 0, "_id": 0}') FROM inv WHERE doc @? json_filter('{"_id": {"$lte": 2}}') ORDER BY json_sort_key(doc, '{"_id": 1}')
----
{"qty": 25, "item": "journal", "status": "A"}
{"qty": 50, "item": "notebook", "status": "A"}

# $slice of an array, with fields included
query T
SELECT json_project(doc, '{"tags": {"$slice": 1}, "item": 1}') FROM inv WHERE doc @? json_filter('{"tags": "red"}') ORDER BY json_sort_key(doc, '{"_id": 1}')
----
{"_id": 1, "item": "journal", "tags": ["blank"]}
{"_id": 2, "item": "notebook", "tags": ["red"]}
{"_id": 3, "item": "paper", "tags": ["red"]}
{"_id": 4, "item": "planner", "tags": ["blank"]}

# $slice [skip, n]; from the end
query T
SELECT json_project(doc, '{"tags": {"$slice": [-2, 1]}}') FROM inv WHERE doc @? json_filter('{"tags": {"$size": 3}}') ORDER BY json_sort_key(doc, '{"_id": 1}')
----
{"_id": 3, "qty": 100, "item": "paper", "size": {"h": 8.5, "w": 11}, "tags": ["blank"], "status": "D"}

# $set a field in an object, and one more
statement ok
UPDATE inv SET doc = json_update(doc, '{"$set": {"size.uom": "cm", "status": "P"}}') WHERE doc @? json_filter('{"item": "paper"}')

query T
SELECT doc FROM inv ORDER BY json_sort_key(doc, '{"_id": 1}')
----
{"_id": 1, "qty": 25, "item": "journal", "size": {"h": 14, "w": 21}, "tags": ["blank", "red"], "status": "A"}
{"_id": 2, "qty": 50, "item": "notebook", "size": {"h": 8.5, "w": 11}, "tags": ["red", "blank"], "status": "A"}
{"_id": 3, "qty": 100, "item": "paper", "size": {"h": 8.5, "w": 11, "uom": "cm"}, "tags": ["red", "blank", "plain"], "status": "P"}
{"_id": 4, "qty": 75, "item": "planner", "size": {"h": 22.85, "w": 30}, "tags": ["blank", "red"], "status": "D"}
{"_id": 5, "qty": 45, "item": "postcard", "size": {"h": 10, "w": 15.25}, "tags": ["blue"], "status": "A"}
{"_id": 6, "qty": "many", "item": "misc", "tags": [], "status": null}
{"_id": 7, "item": "box", "sizes": [{"h": 1}, {"h": 5, "w": 2}]}

# $inc and $push with $each and $position, on every match
statement ok
UPDATE inv SET doc = json_update(doc, '{"$inc": {"qty": -5}, "$push": {"tags": {"$each": ["x", "y"], "$position": 0}}}') WHERE doc @? json_filter('{"qty": {"$lt": 50}}')

query T
SELECT doc FROM inv ORDER BY json_sort_key(doc, '{"_id": 1}')
----
{"_id": 1, "qty": 20, "item": "journal", "size": {"h": 14, "w": 21}, "tags": ["x", "y", "blank", "red"], "status": "A"}
{"_id": 2, "qty": 50, "item": "notebook", "size": {"h": 8.5, "w": 11}, "tags": ["red", "blank"], "status": "A"}
