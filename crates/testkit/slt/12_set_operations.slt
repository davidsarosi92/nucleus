# UNION, EXCEPT and INTERSECT, with and without ALL (results checked
# against PostgreSQL 16).

statement ok
CREATE TABLE a (x INT)

statement ok
CREATE TABLE b (x INT)

statement ok
INSERT INTO a VALUES (1), (1), (1), (2), (3), (NULL), (NULL)

statement ok
INSERT INTO b VALUES (1), (3), (3), (4), (NULL)

# NULLs are equal to each other in set operations.
query I
SELECT x FROM a EXCEPT SELECT x FROM b ORDER BY 1
----
2

query I
SELECT x FROM a EXCEPT ALL SELECT x FROM b ORDER BY 1
----
1
1
2
NULL

query I
SELECT x FROM a INTERSECT SELECT x FROM b ORDER BY 1
----
1
3
NULL

query I
SELECT x FROM a INTERSECT ALL SELECT x FROM b ORDER BY 1
----
1
3
NULL

# INTERSECT binds tighter than UNION and EXCEPT, which are left-associative.
query I
SELECT 1 UNION SELECT 2 INTERSECT SELECT 2 ORDER BY 1
----
1
2

query I
SELECT 1 EXCEPT SELECT 1 UNION SELECT 3 ORDER BY 1
----
3

query I
(SELECT x FROM a UNION ALL SELECT x FROM b) EXCEPT (SELECT 1) ORDER BY 1 NULLS FIRST
----
NULL
2
3
4

query I
SELECT x FROM a INTERSECT SELECT x FROM b INTERSECT SELECT 3
----
3

query IT
SELECT 1, 'a' EXCEPT SELECT 1, 'b'
----
1 a

statement error 42601
SELECT 1 EXCEPT SELECT 1, 2

query I
SELECT x FROM a EXCEPT DISTINCT SELECT x FROM b ORDER BY 1 DESC LIMIT 1
----
2

# In subqueries and with an empty side.
query I
SELECT count(*) FROM (SELECT x FROM a INTERSECT ALL SELECT x FROM b) s
----
3

query I
SELECT x FROM a WHERE x IN (SELECT x FROM a EXCEPT SELECT 1) ORDER BY 1
----
2
3

query I
SELECT x FROM b EXCEPT SELECT x FROM a WHERE false ORDER BY 1
----
1
3
4
NULL

query I
SELECT x FROM b INTERSECT SELECT x FROM a WHERE false
----

query T
EXPLAIN SELECT x FROM a EXCEPT ALL SELECT x FROM b
----
Except All
  Project: #0
    Seq Scan on a
  Project: #0
    Seq Scan on b
