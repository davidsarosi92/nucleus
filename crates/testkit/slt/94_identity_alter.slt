# Identity columns changed (issue #23, third step): ALTER COLUMN … ADD
# GENERATED … AS IDENTITY, SET GENERATED, SET options, RESTART, DROP
# IDENTITY.  Checked against PostgreSQL 18 in one session
# (scripts/slt-pg.py --session).

statement ok
CREATE TABLE t (id int, v text)

statement ok
INSERT INTO t VALUES (1, 'a'), (2, 'b')

# NOT NULL first
statement error 55000
ALTER TABLE t ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY

statement ok
ALTER TABLE t ALTER COLUMN id SET NOT NULL

statement error 22023
ALTER TABLE t ALTER COLUMN v ADD GENERATED ALWAYS AS IDENTITY

statement ok
ALTER TABLE t ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY (START WITH 10)

# Already one
statement error 55000
ALTER TABLE t ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY

statement ok
INSERT INTO t (v) VALUES ('c')

statement error 428C9
INSERT INTO t VALUES (3, 'd')

query IT
SELECT id, v FROM t ORDER BY id
----
1 a
2 b
10 c

query T
SELECT pg_get_serial_sequence('t', 'id')
----
public.t_id_seq

# SET GENERATED BY DEFAULT: values given are taken
statement ok
ALTER TABLE t ALTER COLUMN id SET GENERATED BY DEFAULT

statement ok
INSERT INTO t VALUES (3, 'd')

# Its sequence's options, RESTART
statement ok
ALTER TABLE t ALTER COLUMN id SET INCREMENT BY 5 RESTART WITH 100

statement ok
INSERT INTO t (v) VALUES ('e'), ('f')

query IT
SELECT id, v FROM t WHERE v IN ('e', 'f') ORDER BY id
----
100 e
105 f

statement ok
ALTER TABLE t ALTER COLUMN id RESTART

statement ok
INSERT INTO t (v) VALUES ('g')

query IT
SELECT id, v FROM t WHERE v = 'g'
----
10 g

statement ok
ALTER TABLE t ALTER COLUMN id SET GENERATED ALWAYS SET INCREMENT BY 1

statement error 428C9
INSERT INTO t VALUES (7, 'h')

# Not an identity column
statement error 55000
ALTER TABLE t ALTER COLUMN v SET GENERATED ALWAYS

statement error 55000
ALTER TABLE t ALTER COLUMN v DROP IDENTITY

statement ok
ALTER TABLE t ALTER COLUMN v DROP IDENTITY IF EXISTS

# DROP IDENTITY: no default, no sequence; NOT NULL kept
statement ok
ALTER TABLE t ALTER COLUMN id DROP IDENTITY

statement error 23502
INSERT INTO t (v) VALUES ('i')

statement ok
INSERT INTO t VALUES (500, 'i')

statement error 42P01
SELECT nextval('t_id_seq')

query T
SELECT pg_get_serial_sequence('t', 'id')
----
NULL

statement ok
DROP TABLE t
