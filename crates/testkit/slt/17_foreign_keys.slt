# A unique index a foreign key relies on cannot be dropped.
statement ok
CREATE TABLE code (c TEXT, CONSTRAINT code_c_key UNIQUE (c))

statement ok
CREATE TABLE uses_code (c TEXT REFERENCES code (c))

statement error 2BP01
ALTER TABLE code DROP CONSTRAINT code_c_key

statement ok
DROP TABLE uses_code

statement ok
ALTER TABLE code DROP CONSTRAINT code_c_key

# nucleus-only
statement error 0A000
CREATE TABLE deferred (x INT REFERENCES book DEFERRABLE INITIALLY DEFERRED)

# Concurrency (nucleus-only: PostgreSQL blocks on row locks where nucleus
# fails one transaction at commit).  A child inserted while its parent is
# deleted: one of the two must fail.
# nucleus-only
statement ok
CREATE TABLE p (id INT PRIMARY KEY)

# nucleus-only
statement ok
CREATE TABLE c (id INT PRIMARY KEY, pid INT REFERENCES p)

# nucleus-only
statement ok
CREATE INDEX c_pid ON c (pid)

# nucleus-only
statement ok
INSERT INTO p VALUES (1), (2), (3)

connection a


# nucleus-only
statement ok
BEGIN

# nucleus-only
statement ok
INSERT INTO c VALUES (10, 1)

connection b


# nucleus-only
statement ok
DELETE FROM p WHERE id = 1

connection a


# nucleus-only
statement error 40001
COMMIT

# The other order: the delete saw no children, then one was inserted.
# nucleus-only
statement ok
BEGIN

# nucleus-only
statement ok
DELETE FROM p WHERE id = 2

connection b


# nucleus-only
statement ok
INSERT INTO c VALUES (11, 2)

connection a


# nucleus-only
statement error 40001
COMMIT

# Children of the same parent do not conflict with each other.
# nucleus-only
statement ok
BEGIN

# nucleus-only
statement ok
INSERT INTO c VALUES (12, 3)

connection b


# nucleus-only
statement ok
INSERT INTO c VALUES (13, 3)

connection a


# nucleus-only
statement ok
COMMIT

# nucleus-only
query II rowsort
SELECT id, pid FROM c
----
11 2
12 3
13 3

# nucleus-only
query I rowsort
SELECT id FROM p
----
2
3
