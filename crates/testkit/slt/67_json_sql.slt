SELECT NULL::text IS JSON, NULL::text IS JSON VALUE, NULL::text IS JSON OBJECT, NULL::text IS JSON ARRAY, NULL::text IS JSON SCALAR, NULL::text IS JSON WITH UNIQUE KEYS, NULL::text IS NOT JSON, NULL::text IS JSON OBJECT WITHOUT UNIQUE KEYS
----
NULL NULL NULL NULL NULL NULL NULL NULL

query TTTTTTTT
SELECT '{"a": {"b": 1, "b": 2}}' IS JSON, '{"a": {"b": 1, "b": 2}}' IS JSON VALUE, '{"a": {"b": 1, "b": 2}}' IS JSON OBJECT, '{"a": {"b": 1, "b": 2}}' IS JSON ARRAY, '{"a": {"b": 1, "b": 2}}' IS JSON SCALAR, '{"a": {"b": 1, "b": 2}}' IS JSON WITH UNIQUE KEYS, '{"a": {"b": 1, "b": 2}}' IS NOT JSON, '{"a": {"b": 1, "b": 2}}' IS JSON OBJECT WITHOUT UNIQUE KEYS
----
t t t f f f f t

