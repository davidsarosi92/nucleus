# nucleus-only: a PASSING value is passed as json (to_json's), so a date is
# its ISO string, which .datetime() reads; PostgreSQL passes it as a
# datetime item (type() date; .datetime() of it fails, NULL ON ERROR).
query T
SELECT JSON_VALUE(jsonb '1', '$d.type()' PASSING date '2020-01-01' AS d)
----
string

# nucleus-only: as above.
query T
SELECT JSON_VALUE(jsonb '1', '$d.datetime().type()' PASSING date '2020-01-01' AS d)
----
date

