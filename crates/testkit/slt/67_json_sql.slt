# SQL/JSON's functions (PLAN.md §M14.15 J3b): JSON_EXISTS, JSON_VALUE,
# JSON_QUERY with PASSING, RETURNING, wrappers, quotes and ON EMPTY / ON
# ERROR; IS JSON; the constructors JSON_OBJECT, JSON_ARRAY,
# JSON_OBJECTAGG, JSON_ARRAYAGG, JSON, JSON_SCALAR, JSON_SERIALIZE.
# Expected results produced by PostgreSQL 18 (scripts/slt-pg.py check),
# records marked nucleus-only excepted.

statement ok
CREATE TABLE sj (id int PRIMARY KEY, doc jsonb, t text)

statement ok
INSERT INTO sj VALUES
  (1, '{"a": 1, "b": [1, 2, 3], "c": {"d": "x"}, "s": "text", "n": null, "f": 1.5, "dt": "2020-01-01"}', '{"a": 1}'),
  (2, '{"a": 2, "b": [], "c": {}}', '[1, 2]'),
  (3, NULL, 'not json'),
  (4, '[1, "two", null]', '{"a": 1, "a": 2}'),
  (5, '"scalar"', '42')

