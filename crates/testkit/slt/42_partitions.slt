# A storage policy: partitions of ranges long ended take column storage.
statement ok
CREATE TABLE log (at DATE, n INT, PRIMARY KEY (at, n)) PARTITION BY RANGE (at)

statement ok
CREATE TABLE log_old PARTITION OF log FOR VALUES FROM ('2020-01-01') TO ('2021-01-01')

statement ok
CREATE TABLE log_new PARTITION OF log FOR VALUES FROM ('2021-01-01') TO (MAXVALUE)

statement ok
INSERT INTO log VALUES ('2020-06-01', 1), ('2020-07-01', 2), ('2099-01-01', 3)

statement error 42809
ALTER TABLE pm SET STORAGE POLICY (column AFTER interval '30 days')

statement ok
ALTER TABLE log SET STORAGE POLICY (column AFTER interval '30 days')

query TT
SELECT name, storage FROM nc_catalog.tables WHERE name LIKE 'log%' ORDER BY name
----
log row
log_new row
log_old column

query TI
SELECT at, n FROM log ORDER BY at
----
2020-06-01 1
2020-07-01 2
2099-01-01 3

statement ok
ALTER TABLE log SET STORAGE POLICY NONE

statement ok
