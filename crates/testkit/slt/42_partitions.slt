# Attach, detach, drop a partition.
statement ok
CREATE TABLE pm (id INT, k INT, v TEXT, PRIMARY KEY (k, id)) PARTITION BY RANGE (k)

statement ok
CREATE TABLE pm1 PARTITION OF pm FOR VALUES FROM (0) TO (10)

statement ok
CREATE INDEX pm_v ON pm (v)

statement ok
INSERT INTO pm VALUES (1, 5, 'a')

statement ok
CREATE TABLE pm2 (id INT, k INT, v TEXT, PRIMARY KEY (k, id))

statement ok
INSERT INTO pm2 VALUES (2, 15, 'b'), (3, 25, 'c')

# A row outside the bound: refused.
statement error 23514
ALTER TABLE pm ATTACH PARTITION pm2 FOR VALUES FROM (10) TO (20)

# Overlapping another partition: refused.
statement error
ALTER TABLE pm ATTACH PARTITION pm2 FOR VALUES FROM (5) TO (30)

statement ok
ALTER TABLE pm ATTACH PARTITION pm2 FOR VALUES FROM (10) TO (30)

query ITT
SELECT id, k, v FROM pm ORDER BY id
----
1 5 a
2 15 b
3 25 c

query I
SELECT id FROM pm WHERE v = 'c'
----
3

statement error 23514
INSERT INTO pm2 VALUES (4, 35, 'd')

# Columns that differ: refused.
statement ok
CREATE TABLE odd (id INT, k BIGINT, v TEXT, PRIMARY KEY (k, id))

statement error 22023
ALTER TABLE pm ATTACH PARTITION odd FOR VALUES FROM (30) TO (40)

statement ok
ALTER TABLE pm DETACH PARTITION pm2

query I
SELECT count(*) FROM pm
----
