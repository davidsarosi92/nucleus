# chunks(text, by, size [, overlap [, model]]): a text cut into the pieces
# an embedding model takes (PLAN.md §M14.22 E6).  nucleus-only.

query ITIIT
SELECT position, chunk, start, length, size FROM chunks('One two three. Four five. Six seven eight nine. Ten.', 'sentences', 5)
----
1 One two three. Four five. 1 25 5
2 Six seven eight nine. Ten. 27 26 5

# Overlap: the last whole sentences of the chunk before, where the next
# has room.
query T
SELECT chunk FROM chunks('One two three. Four five. Six seven eight nine. Ten.', 'sentences', 6, 2) ORDER BY position
----
One two three. Four five.
Four five. Six seven eight nine.
Ten.

# Windows of words.
query T
SELECT chunk FROM chunks('a b c d e f g', 'tokens', 3, 1)
----
a b c
c d e
e f g

# Markdown: sections by heading, never crossed; the heading path beside.
statement ok
CREATE TABLE docs (id int PRIMARY KEY, body text)

statement ok
INSERT INTO docs VALUES (1, E'Intro.\n\n# Guide\n\nInstall it first.\n\n## Usage\n\nRun it.  Stop it.\n\n```\n# a comment, not a heading\n```\n'), (2, 'Árvíztűrő tükörfúrógép. Második mondat!'), (3, NULL)

query ITT
SELECT d.id, replace(c.chunk, E'\n', '|'), array_to_string(c.headings, ' > ') FROM docs d, chunks(d.body, 'markdown', 50) c ORDER BY d.id, c.position
----
1 Intro. (empty)
1 # Guide||Install it first. Guide
1 ## Usage||Run it.  Stop it.||```|# a comment, not a heading|``` Guide > Usage
2 Árvíztűrő tükörfúrógép. Második mondat! (empty)

# Offsets in characters, as substr takes them.
query I
SELECT count(*) FROM docs d, chunks(d.body, 'sentences', 3) c WHERE substr(d.body, c.start, c.length) <> c.chunk
----
0

query IT
SELECT c.start, c.chunk FROM docs d, chunks(d.body, 'sentences', 2) c WHERE d.id = 2
----
1 Árvíztűrő tükörfúrógép.
25 Második mondat!

# What is refused.
statement error 22023
SELECT * FROM chunks('a b', 'paragraphs', 3)

statement error 22023
SELECT * FROM chunks('a b', 'tokens', 3, 3)

statement error 22023
SELECT * FROM chunks('a b', 'tokens', 0)

statement error 22023
SELECT * FROM chunks('a b', 'tokens', -1)

statement error 42704
SELECT * FROM chunks('a b', 'tokens', 3, 0, 'no_such_model')

# A model that cannot count its tokens.
statement ok
CREATE MODEL h USING hashing WITH (dimensions = 8)

statement error 0A000
SELECT * FROM chunks('a b', 'tokens', 3, 0, 'h')
