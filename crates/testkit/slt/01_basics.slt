# Tables, inserts, selects, ordering and limits.

statement ok
CREATE TABLE people (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, city TEXT)

statement ok
INSERT INTO people VALUES (1, 'Anna', 34, 'Budapest'), (2, 'Béla', 27, 'Szeged'), (3, 'Csilla', NULL, 'Budapest')

statement ok
INSERT INTO people (id, name, city) VALUES (4, 'Dénes', 'Pécs')

query ITIT
SELECT id, name, age, city FROM people ORDER BY id
----
1 Anna 34 Budapest
2 Béla 27 Szeged
3 Csilla NULL Budapest
4 Dénes NULL Pécs

query T rowsort
SELECT name FROM people WHERE city = 'Budapest'
----
Anna
Csilla

query IT
SELECT id, name FROM people WHERE age > 30 OR age IS NULL ORDER BY id DESC
----
4 Dénes
3 Csilla
1 Anna

query T
SELECT name FROM people ORDER BY age DESC, name
----
Csilla
Dénes
Anna
Béla

query T
SELECT name FROM people ORDER BY age NULLS FIRST, id
----
Csilla
Dénes
Béla
Anna

query I
SELECT id FROM people ORDER BY id LIMIT 2 OFFSET 1
----
2
3

query IT
SELECT p.id AS n, upper(p.name) AS loud FROM people AS p WHERE p.id IN (2, 4) ORDER BY n
----
2 BÉLA
4 DÉNES

query T
SELECT DISTINCT city FROM people ORDER BY city
----
Budapest
Pécs
Szeged

query I
SELECT count(*) FROM people
----
4

statement error 23505
