statement error 23502
INSERT INTO people (id) VALUES (9)

statement error 42P01
SELECT * FROM nobody

statement error 42703
SELECT nope FROM people

statement error 42601
SELEC 1

statement ok
CREATE TABLE IF NOT EXISTS people (x INT)

statement error 42P07
CREATE TABLE people (x INT)

# Without a primary key, rows get hidden ids and keep insertion order.
statement ok
CREATE TABLE log (msg TEXT)

statement ok
INSERT INTO log VALUES ('first'), ('second'), ('first')

query T
SELECT msg FROM log
----
first
second
first

query T
SELECT * FROM log WHERE msg = 'first'
----
first
first

statement ok
DROP TABLE log

statement error 42P01
SELECT * FROM log

statement ok
DROP TABLE IF EXISTS log

# SELECT without FROM.
query IRT
SELECT 1 + 2, 7 / 2.0, 'a' || 'b'
----
3 3.500 ab

query I
SELECT 7 / 2
----
3

query B
SELECT 1 < 2
----
true
