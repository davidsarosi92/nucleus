# Plans: equality on any scalar, ranges on numbers, through arrays
query T
EXPLAIN SELECT doc FROM people WHERE doc @? json_filter('{"tags": "vip"}')
----
Project: #1
  Index Scan using people_tags_idx on people ((json_path_query(doc, '$."tags"[*]')) = "vip") filter: @?(json,jsonpath)(#1, $?(@."tags" == "vip"))

query T
EXPLAIN SELECT doc FROM people WHERE doc @? json_filter('{"address.city": "Wien", "age": {"$gt": 30}}')
----
Project: #1
  Index Scan using people_address_city_idx on people ((json_path_query(doc, '$."address"."city"[*]')) = "Wien") filter: @?(json,jsonpath)(#1, $?(@."age" > 30 && @."address"."city" == "Wien"))

query T
EXPLAIN SELECT doc FROM people WHERE doc @? json_filter('{"age": {"$gte": 50}}')
----
Project: #1
  Index Scan using people_age_idx on people ((json_path_query(doc, '$."age"[*]')) >= 50) filter: @?(json,jsonpath)(#1, $?(@."age" >= 50))

query T
EXPLAIN SELECT doc FROM people WHERE doc @? '$.orders ? (@.sku == "C3")'
----
Project: #1
  Index Scan using people_orders_sku_idx on people ((json_path_query(doc, '$."orders"."sku"[*]')) = "C3") filter: @?(json,jsonpath)(#1, $."orders"?(@."sku" == "C3"))

# A constant on the left: `30 > @.age` is a bound below 30, `30 <
# @.age` above
query I
SELECT (doc->>'_id')::int FROM people WHERE doc @? '$ ? (30 > @.age)'
----
3

query T
EXPLAIN SELECT doc FROM people WHERE doc @? '$ ? (30 > @.age)'
----
Project: #1
  Index Scan using people_age_idx on people ((json_path_query(doc, '$."age"[*]')) < 30) filter: @?(json,jsonpath)(#1, $?(30 > @."age"))

query I rowsort
SELECT (doc->>'_id')::int FROM people WHERE doc @? '$ ? (30 < @.age)'
----
1
6

# Only the part's own path: `city` is not `address.city`; `!=` no bound
query T
EXPLAIN SELECT doc FROM people WHERE doc @? json_filter('{"city": "Wien"}')
----
Project: #1
  Seq Scan on people filter: @?(json,jsonpath)(#1, $?(@."city" == "Wien"))

query T
EXPLAIN SELECT doc FROM people WHERE doc @? '$ ? (@.name != "ann")'
----
Project: #1
  Seq Scan on people filter: @?(json,jsonpath)(#1, $?(@."name" != "ann"))

# A `->` chain's equality with a scalar or an object: its value is one
# of the index's
query T
EXPLAIN SELECT doc FROM people WHERE doc -> 'name' = '"ann"'
----
Project: #1
  Index Scan using people_name_idx on people ((json_path_query(doc, '$."name"[*]')) = "ann") filter: (->(json,text)(#1, 'name') = "ann")

query I
SELECT (doc->>'_id')::int FROM people WHERE doc -> 'name' = '"ann"'
----
1

# Not served: a range on strings (a path compares them by code point),
# an array's equality (its entries are its elements), a strict path
query T
EXPLAIN SELECT doc FROM people WHERE doc @? json_filter('{"name": {"$gt": "b"}}')
----
Project: #1
  Seq Scan on people filter: @?(json,jsonpath)(#1, $?(@."name" > "b"))

query T
EXPLAIN SELECT doc FROM people WHERE doc -> 'tags' = '["vip", "a"]'
----
Project: #1
  Seq Scan on people filter: (->(json,text)(#1, 'tags') = ["vip", "a"])

query T
EXPLAIN SELECT doc FROM people WHERE doc @? 'strict $ ? (@.tags == "vip")'
----
Project: #1
  Seq Scan on people filter: @?(json,jsonpath)(#1, strict $?(@."tags" == "vip"))

# A UNIQUE path index holds the json value there, as before
statement ok
CREATE UNIQUE INDEX people_nick ON people (nick)

query T
SELECT columns FROM nc_catalog.indexes WHERE name = 'people_nick'
----
{"(doc -> 'nick')"}

# The part on a table: a lax path of keys ending in [*]
statement ok
CREATE TABLE lax_t (id int PRIMARY KEY, j json)

statement ok
CREATE INDEX ON lax_t ((json_path_query(j, '$.a.b[*]')))

statement ok
INSERT INTO lax_t VALUES (1, '{"a": [{"b": [1, 2]}, {"b": 3}]}'), (2, '{"a": {"b": 4}}')

query I rowsort
SELECT id FROM lax_t WHERE j @? '$ ? (@.a.b == 2 || @.a.b == 4)'
----
1
2

query I
SELECT id FROM lax_t WHERE j @? '$ ? (@.a.b == 3)'
----
1

statement error 0A000
CREATE INDEX ON lax_t ((json_path_query(j, '$.a.b')))

statement error 0A000
CREATE INDEX ON lax_t ((json_path_query(j, 'strict $.a[*]')))

statement ok
DROP TABLE lax_t

# The path it compiles to; a constant filter is folded when bound (the
# plan's filter is the path; the index on name serves it)
query T
SELECT json_filter('{"age": {"$gt": 30}, "tags": "vip"}')
----
$?(@."age" > 30 && @."tags" == "vip")

query T
SELECT json_filter('{}')
----
$

query T
EXPLAIN SELECT doc FROM people WHERE doc @? json_filter('{"name": "ann"}')
----
Project: #1
  Index Scan using people_name_idx on people ((json_path_query(doc, '$."name"[*]')) = "ann") filter: @?(json,jsonpath)(#1, $?(@."name" == "ann"))

# What a filter cannot say
statement error 22023
SELECT json_filter('{"age": {"$foo": 1}}')

statement error 22023
SELECT json_filter('{"age": {"$gt": 1, "x": 2}}')

statement error 22023
SELECT json_filter('[1]')

statement error 22023
SELECT json_filter('{"$or": []}')

statement error 0A000
SELECT json_filter('{"$where": "true"}')

statement error 0A000
SELECT json_filter('{"items.0.sku": "A1"}')

statement error 0A000
SELECT json_filter('{"age": {"$gt": [1]}}')

statement error 2201B
SELECT json_filter('{"name": {"$regex": "("}}')

statement ok
DROP COLLECTION people
