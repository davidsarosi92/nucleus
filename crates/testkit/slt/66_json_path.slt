# The SQL/JSON path language (PLAN.md §M14.15 J3a): jsonpath's text,
# lax and strict modes, accessors, filters, predicates, arithmetic, item
# methods, datetimes, variables, silence, the json_path_* functions and
# the @? and @@ operators.  Expected results produced by PostgreSQL 18
# (scripts/slt-pg.py check), records marked nucleus-only excepted.

statement ok
CREATE TABLE pdocs (id int PRIMARY KEY, doc jsonb)

statement ok
INSERT INTO pdocs VALUES
  (1, '{"name": "Ann", "age": 41, "tags": ["a", "b"], "items": [{"sku": "x1", "qty": 2, "price": 9.5}, {"sku": "y2", "qty": 1, "price": 20}], "born": "1984-03-05"}'),
  (2, '{"name": "Bob", "age": null, "tags": [], "items": [{"sku": "x1", "qty": 5, "price": 9.5}], "born": "1990-12-31"}'),
  (3, '{"name": "Cid", "tags": ["b", "c"], "items": [], "born": "not a date"}'),
  (4, '[1, 2, 3]'),
  (5, '"text"')

query T
SELECT '$.a'::jsonpath
----
$."a"

query T
SELECT 'strict $.a[*] ? (@ > 1)'::jsonpath
----
strict $."a"[*]?(@ > 1)

query T
SELECT '$.a ? (@.b == "x" && @.c < 2 || !(@.d >= 3))'::jsonpath
----
$."a"?(@."b" == "x" && @."c" < 2 || !(@."d" >= 3))

query T
SELECT '$.**{1 to last}.x'::jsonpath
----
$.**{1 to last}."x"

query T
SELECT '$.a[1, 2 to last]'::jsonpath
----
$."a"[1,2 to last]

query T
SELECT '($.a + 1) * -$.b'::jsonpath
----
(($."a" + 1) * -$."b")

query T
SELECT '$ ? (@ like_regex "^a.c" flag "si")'::jsonpath
----
$?(@ like_regex "^a.c" flag "is")

query T
SELECT '$ ? (@ starts with $prefix)'::jsonpath
----
$?(@ starts with $"prefix")

query T
SELECT '$.datetime("YYYY-MM-DD HH24:MI").type()'::jsonpath
----
$.datetime("YYYY-MM-DD HH24:MI").type()

query T
SELECT '$.decimal(6, 2).string()'::jsonpath
----
$.decimal(6,2).string()

query T
SELECT '1.5e3'::jsonpath
----
1500

query T
SELECT '$."key with space"'::jsonpath
----
$."key with space"

query T
SELECT '$.a.b.c.size()'::jsonpath
----
$."a"."b"."c".size()

