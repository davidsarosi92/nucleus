# nucleus-only: an id below the root is an offset in the value's binary
# form, which is not PostgreSQL's (PostgreSQL: 10000000016).
query T
SELECT * FROM jsonb_path_query('{"a": 1}', '$x.keyvalue()', '{"x": {"k": 2}}')
