# Table storage (PLAN.md §M14.20 V6): a table names how its rows are
# stored; `row` is built in and the default.

# nucleus-only
statement ok
CREATE TABLE st_a (id INT PRIMARY KEY, v TEXT) WITH (storage = row)

# nucleus-only
statement ok
CREATE TABLE st_b (id INT PRIMARY KEY, a INT REFERENCES st_a (id), v TEXT) WITH (storage = 'row')

statement ok
INSERT INTO st_a VALUES (1, 'one'), (2, 'two')

statement ok
INSERT INTO st_b VALUES (10, 1, 'x'), (20, 2, 'y')

query IT
SELECT b.id, a.v FROM st_b b JOIN st_a a ON a.id = b.a ORDER BY b.id
----
10 one
20 two

# nucleus-only
query TT
SELECT name, storage FROM nc_catalog.tables WHERE name LIKE 'st_%' ORDER BY name
----
st_a row
st_b row

# nucleus-only
query T
SELECT name FROM nc_catalog.storages WHERE name = 'row'
----
row

# nucleus-only
statement error 42704
CREATE TABLE st_c (id INT PRIMARY KEY) WITH (storage = nowhere)

# nucleus-only
statement error 22023
CREATE TABLE st_c (id INT PRIMARY KEY) WITH (fillfactor = 70)

# Columnar storage: the same SQL; segments in nc_catalog.segments.

# nucleus-only
statement ok
CREATE TABLE st_col (id INT PRIMARY KEY, g INT, name TEXT) WITH (storage = column)

# nucleus-only
statement ok
INSERT INTO st_col SELECT i, i % 3, 'n' || i FROM generate_series(1, 5000) i

# nucleus-only
statement ok
UPDATE st_col SET name = 'changed' WHERE id % 1000 = 0

# nucleus-only
statement ok
DELETE FROM st_col WHERE id > 4990

# nucleus-only
query IIT
SELECT count(*), sum(g), max(name) FROM st_col
----
4990 4990 n999

# nucleus-only
query IT
SELECT id, name FROM st_col WHERE id IN (1000, 2000, 4990) ORDER BY id
----
1000 changed
2000 changed
4990 n4990

# nucleus-only
query IB
SELECT count(*), sum(rows) >= 4990 FROM nc_catalog.segments WHERE table_name = 'st_col'
----
1 true

# nucleus-only
statement error 23505
INSERT INTO st_col VALUES (5, 0, 'again')
