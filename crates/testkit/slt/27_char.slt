# char(n): the standard's blank padding and comparison rules — stored
# padded, trailing blanks insignificant in comparisons, removed when it
# becomes text; too long is an error unless the excess is blanks, an
# explicit cast truncates.
# Expected results produced by PostgreSQL 18 (records marked nucleus-only
# excepted).

query TIT
SELECT 'a'::char(3) || '|', length('a'::char(3)), 'a'::char(3)::text || '|'
----
a| 1 a|

query TTT
SELECT 'abcdef'::char(3), 'abc   '::char(3), 'abc'::char
----
abc abc a

query BBBB
SELECT 'a'::char(3) = 'a  '::char(5), 'a'::char(3) = 'a', 'a'::char(3) = 'a '::text, 'a'::char(3) < 'a!'::char(3)
----
true true false true

query TTI
SELECT 'a'::char(3) || 'b', upper('a'::char(3)) || '|', octet_length('a'::char(3))
----
ab A| 3

query BB
SELECT 'a'::char(3) LIKE 'a', 'a'::char(3) LIKE 'a%'
----
false true

statement ok
CREATE TABLE codes (code char(3) PRIMARY KEY, name character(5), v varchar(5))

statement ok
INSERT INTO codes VALUES ('ab', 'x', 'y'), ('a', 'longe', 'z')

statement error 22001
INSERT INTO codes VALUES ('b', 'longer', 'z')

statement error 22001
INSERT INTO codes VALUES ('abcd', 'x', 'y')

statement ok
INSERT INTO codes VALUES ('abc   ', 'x    ', 'w')

statement error 23505
INSERT INTO codes VALUES ('ab ', 'dup', 'd')

query TIIT
SELECT code || '|', length(code), octet_length(code), name || '|' FROM codes ORDER BY code
----
a| 1 3 longe|
ab| 2 3 x|
abc| 3 3 x|

query T
SELECT code || '|' FROM codes WHERE code = 'ab'
----
ab|

query T
SELECT code || '|' FROM codes WHERE code > 'a' AND code < 'abc' ORDER BY code
----
ab|

query TT
SELECT max(code) || '|', min(name) || '|' FROM codes
----
abc| longe|

statement ok
DROP TABLE codes

# IN lists, substr and comparisons with text of char(n) columns (the
# vectorized executor's char vectors, §M14.20).

query BBBB
SELECT 'ab'::char(4) IN ('ab', 'cd'), 'ab '::text IN ('ab'::char(3)), 'ab'::char(3) IN ('ab ', 'x'), 'ab'::char(4) NOT IN ('ab  ')
----
true false true false

query TTT
SELECT substr('ab'::char(4), 1, 3) || '|', substring('é b'::char(5) from 2 for 3) || '|', substr('abc'::char(5), 3) || '|'
----
ab|  b| c|

statement ok
CREATE TABLE codes2 (code char(3) PRIMARY KEY, name character(5))

statement ok
INSERT INTO codes2 VALUES ('ab', 'x'), ('a', 'longe'), ('abc', 'x')

query T
SELECT code || '|' FROM codes2 WHERE code IN ('ab', 'abc ') ORDER BY code
----
ab|
abc|

query T
SELECT code || '|' FROM codes2 WHERE code NOT IN ('ab') ORDER BY code
----
a|
abc|

query TI
SELECT substr(code, 1, 1) || '|', count(*) FROM codes2 GROUP BY 1 ORDER BY 1
----
a| 3

query T
SELECT code || '|' FROM codes2 WHERE substring(code from 2 for 2) IN ('b', 'bc') ORDER BY code
----
ab|
abc|

query T
SELECT code || '|' FROM codes2 WHERE code = name OR name = 'x' ORDER BY code
----
ab|
abc|

statement ok
DROP TABLE codes2
