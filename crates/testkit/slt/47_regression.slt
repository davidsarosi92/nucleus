# Two variables (PLAN.md §M14.27 S3): PostgreSQL's corr, covar_* and
# regr_*, arguments (y, x), from exact sums rounded once.  Expectations
# from PostgreSQL 18 where its digits are exact; where they are not
# (its update rounds a row at a time), the exact value, PostgreSQL's in
# a comment.

# PostgreSQL: corr 0.9606823206141611, intercept -0.20000000000000018.
query TTTTTT
SELECT corr(y, x)::text, covar_pop(y, x)::text, covar_samp(y, x)::text, regr_slope(y, x)::text, regr_intercept(y, x)::text, regr_r2(y, x)::text FROM (VALUES (1.0::float8, 2.0::float8), (2.5, 3.0), (2.0, 5.0), (7.0, 11.0)) v(y, x)
----
0.960682320614161 7.71875 10.291666666666666 0.6333333333333333 -0.2 0.9229105211406097

query TTTTTT
SELECT regr_count(y, x)::text, regr_avgx(y, x)::text, regr_avgy(y, x)::text, regr_sxx(y, x)::text, regr_syy(y, x)::text, regr_sxy(y, x)::text FROM (VALUES (1.0::float8, 2.0::float8), (2.5, 3.0), (2.0, 5.0), (7.0, 11.0)) v(y, x)
----
4 5.25 3.125 48.75 21.1875 30.875

# A row with either value NULL is left out; integers become doubles.
query TTTT
SELECT corr(y, x)::text, regr_slope(y, x)::text, regr_count(y, x)::text, regr_avgx(y, x)::text FROM (VALUES (1, 2), (NULL, 3), (2, NULL), (5, 7), (4, 4)) v(y, x)
----
0.9226129063148778 0.7631578947368421 3 4.333333333333333

# One row: no spread, so no slope, r² or correlation.
query TTTTTT
SELECT corr(y, x)::text, regr_slope(y, x)::text, regr_r2(y, x)::text, covar_samp(y, x)::text, covar_pop(y, x)::text, regr_sxx(y, x)::text FROM (VALUES (1.0::float8, 2.0::float8)) v(y, x)
----
NULL NULL NULL NULL 0 0

# A horizontal line: r² 1, no correlation.
query TTTT
SELECT corr(y, x)::text, regr_slope(y, x)::text, regr_r2(y, x)::text, regr_intercept(y, x)::text FROM (VALUES (1.0::float8, 2.0::float8), (1.0, 3.0)) v(y, x)
----
NULL 0 1 1

# A vertical one: nothing.
query TTT
SELECT corr(y, x)::text, regr_slope(y, x)::text, regr_r2(y, x)::text FROM (VALUES (1.0::float8, 2.0::float8), (3.0, 2.0)) v(y, x)
----
NULL NULL NULL

query TTT
SELECT regr_count(y, x)::text, corr(y, x)::text, regr_avgx(y, x)::text FROM (SELECT 1::float8 y, 1::float8 x WHERE false) q
----
0 NULL NULL

# NaN and infinities: what depends on them is NaN.
query TTTTTTTT
SELECT corr(y, x)::text, regr_slope(y, x)::text, regr_sxx(y, x)::text, regr_syy(y, x)::text, regr_sxy(y, x)::text, regr_avgx(y, x)::text, regr_avgy(y, x)::text, regr_r2(y, x)::text FROM (VALUES ('NaN'::float8, 1.0::float8), (2, 3), (4, 5)) v(y, x)
----
NaN NaN 8 NaN NaN 3 NaN NaN

query TTTTTTT
SELECT corr(y, x)::text, regr_slope(y, x)::text, regr_sxx(y, x)::text, regr_syy(y, x)::text, regr_avgx(y, x)::text, regr_r2(y, x)::text, regr_intercept(y, x)::text FROM (VALUES (1::float8, 'Infinity'::float8), (1, 3), (1, 5)) v(y, x)
----
NULL NaN NaN 0 Infinity 1 NaN

# On a large offset.  PostgreSQL: 0.9844951419814171 1.0499995946884155
# 1000000000.0000001 0.01749999324480692.
query TTTT
SELECT corr(y, x)::text, regr_slope(y, x)::text, regr_intercept(y, x)::text, covar_samp(y, x)::text FROM (VALUES (1e9 + 0.1::float8, 0.1::float8), (1e9 + 0.2, 0.2), (1e9 + 0.35, 0.3), (1e9 + 0.4, 0.4)) v(y, x)
----
0.9844951677750776 1.0499998331069946 1000000000.0000001 0.01749999721844991

query TT
SELECT corr(y, x)::text, corr(-y, x)::text FROM (VALUES (1::float8, 1::float8), (2, 2), (3, 3)) v(y, x)
----
1 -1

statement error 22003
SELECT covar_pop(y, x) FROM (VALUES (1e200::float8, 1e200::float8), (2e200, 2e200)) v(y, x)

statement error 42883
SELECT corr(y, x) FROM (VALUES ('a'::text, 1)) v(y, x)

# By group (PostgreSQL's correlations: 0.9745586289152094,
# 0.967419396817622, 0.9713144684310773).
statement ok
CREATE TABLE r (id INT PRIMARY KEY, g INT, x FLOAT, y FLOAT)

statement ok
INSERT INTO r SELECT i, i % 3, i * 0.5, i * i * 0.25 + 1 FROM generate_series(1, 30) i

query ITTT
SELECT g, regr_slope(y, x)::text, regr_intercept(y, x)::text, corr(y, x)::text FROM r GROUP BY g ORDER BY g
----
0 16.5 -48.5 0.9745586289152093
1 14.5 -33 0.9674193968176221
2 15.5 -40.5 0.9713144684310772

statement ok
DROP TABLE r
