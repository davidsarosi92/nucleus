2
3

# The rows in the document's order, a parent's before its children's.
query TTT
SELECT * FROM JSON_TABLE(jsonb '{"a": [3, 1, 2], "b": ["y", "x"]}', '$' COLUMNS (NESTED PATH '$.a[*]' COLUMNS (a int PATH '$'), NESTED PATH '$.b[*]' COLUMNS (b text PATH '$', bn FOR ORDINALITY)))
----
3 NULL NULL
1 NULL NULL
2 NULL NULL
NULL y 1
NULL x 2

query ITT
SELECT n, sku, tag FROM jt, JSON_TABLE(jt.doc, '$.items[*]' COLUMNS (n FOR ORDINALITY, sku text, NESTED PATH '$.tags[*]' COLUMNS (tag text PATH '$'))) j WHERE jt.id = 1
----
1 a1 x
1 a1 y
2 b2 NULL

# nucleus-only: a DEFAULT may read the row's columns (PostgreSQL: 42804,
# "DEFAULT expression must not contain column references").
query II
SELECT jt.id, j.q FROM jt, JSON_TABLE(jt.doc, '$.items[*]' COLUMNS (q int PATH '$.qty' DEFAULT jt.id * 100 ON ERROR)) j ORDER BY 1, 2
----
1 2
1 100
3 5

query ITI
WITH items AS (SELECT jt.id, j.sku, j.qty FROM jt, JSON_TABLE(jt.doc, '$.items[*]' COLUMNS (sku text, qty int PATH '$.qty' DEFAULT 0 ON ERROR)) j) SELECT * FROM items ORDER BY 1, 2
----
1 a1 2
1 b2 0
3 c3 5

query I
SELECT sum(qty) FROM (SELECT j.qty FROM jt, JSON_TABLE(jt.doc, '$.items[*]' COLUMNS (qty int PATH '$.qty' DEFAULT 0 ON ERROR)) j) s
----
7

query TI
SELECT j.k, j.v FROM JSON_TABLE(jsonb '{"b": 2, "a": 1}', '$.keyvalue()' COLUMNS (k text PATH '$.key', v int PATH '$.value')) j ORDER BY 1
----
a 1
b 2
