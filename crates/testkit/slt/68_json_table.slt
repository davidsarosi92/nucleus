SELECT * FROM JSON_TABLE(jsonb '{"a": [{"x": 1, "y": "one"}, {"x": 2, "y": "two", "z": [1, 2]}, {"x": "bad"}]}', '$.a[*] ? (@.x > $m)' PASSING 1 AS m COLUMNS (x int))
