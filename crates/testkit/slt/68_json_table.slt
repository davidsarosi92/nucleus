query ITIT
SELECT jt.id, j.* FROM jt, JSON_TABLE(jt.doc, '$.items[*]' COLUMNS (sku text, n FOR ORDINALITY, qty int)) AS j ORDER BY jt.id, j.n
----
1 a1 1 2
1 b2 2 NULL
3 c3 1 5

query IT
SELECT id, name FROM jt, JSON_TABLE(doc, '$' COLUMNS (name text PATH '$.name', city text PATH '$.addr.city')) j ORDER BY id
----
1 Ann
2 Bob
3 Cy
5 NULL

query ITT
SELECT id, name, city FROM jt CROSS JOIN JSON_TABLE(doc, '$' COLUMNS (name text PATH '$.name', city text PATH '$.addr.city')) AS j ORDER BY id
----
1 Ann Pécs
2 Bob NULL
3 Cy NULL
5 NULL NULL

query ITI
SELECT jt.id, j.sku, j.qty FROM jt LEFT JOIN JSON_TABLE(jt.doc, '$.items[*]' COLUMNS (sku text, qty int)) AS j ON true ORDER BY 1, 2
----
1 a1 2
1 b2 NULL
2 NULL NULL
3 c3 5
4 NULL NULL
5 NULL NULL

query I rowsort
SELECT count(*) FROM jt, JSON_TABLE(jt.doc, '$.items[*].tags[*]' COLUMNS (t text PATH '$')) j
----
3

query TI
SELECT j.t, count(*) FROM jt, JSON_TABLE(jt.doc, '$.items[*].tags[*]' COLUMNS (t text PATH '$')) j GROUP BY j.t ORDER BY 1
----
x 1
y 1
z 1

query ITIT
SELECT j.* FROM jt, JSON_TABLE(jt.doc, '$' COLUMNS (id FOR ORDINALITY, name text, NESTED PATH '$.items[*]' COLUMNS (sku text, n FOR ORDINALITY))) j ORDER BY jt.id, j.n NULLS FIRST
----
1 Ann a1 1
1 Ann b2 2
1 Bob NULL NULL
1 Cy c3 1
1 NULL NULL NULL

query TTT rowsort
SELECT name, sku, tag FROM jt, JSON_TABLE(jt.doc, '$' COLUMNS (name text, NESTED PATH '$.items[*]' COLUMNS (sku text, NESTED PATH '$.tags[*]' COLUMNS (tag text PATH '$')))) j WHERE jt.id <= 3
----
Ann a1 x
Ann a1 y
Ann b2 NULL
Bob NULL NULL
Cy c3 z

query TTTI rowsort
SELECT name, sku, tag, p FROM jt, JSON_TABLE(jt.doc, '$' COLUMNS (name text, NESTED PATH '$.items[*]' COLUMNS (sku text, NESTED PATH '$.tags[*]' COLUMNS (tag text PATH '$'), NESTED PATH '$.parts[*]' COLUMNS (p int)))) j WHERE jt.id <= 3
----
Ann a1 x NULL
Ann a1 y NULL
Ann b2 NULL NULL
Bob NULL NULL NULL
Cy c3 NULL 1
Cy c3 NULL 2
Cy c3 z NULL

