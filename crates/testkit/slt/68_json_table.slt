# JSON_TABLE (PLAN.md §M14.15 J3c): rows from an SQL/JSON path, columns
# from paths relative to each (FOR ORDINALITY, a typed path as JSON_VALUE
# or JSON_QUERY reads it, EXISTS), NESTED PATH joined to its parent and
# siblings unioned, PASSING, ON EMPTY / ON ERROR per column and for the
# table.  Expected results produced by PostgreSQL 18 (scripts/slt-pg.py
# check), records marked nucleus-only excepted.

statement ok
CREATE TABLE jt (id int PRIMARY KEY, doc jsonb)

statement ok
INSERT INTO jt VALUES
  (1, '{"name": "Ann", "items": [{"sku": "a1", "qty": 2, "tags": ["x", "y"]}, {"sku": "b2", "qty": "many", "tags": []}], "addr": {"city": "Pécs"}}'),
  (2, '{"name": "Bob", "items": [], "addr": null}'),
  (3, '{"name": "Cy", "items": [{"sku": "c3", "qty": 5, "tags": ["z"], "parts": [{"p": 1}, {"p": 2}]}]}'),
  (4, NULL),
  (5, '[1, 2]')

query IT rowsort
SELECT * FROM JSON_TABLE(jsonb '{"a": [{"x": 1, "y": "one"}, {"x": 2, "y": "two", "z": [1, 2]}, {"x": "bad"}]}', '$.a[*]' COLUMNS (x int PATH '$.x', y text PATH '$.y'))
----
1 one
2 two
NULL NULL

query IIT rowsort
SELECT * FROM JSON_TABLE(jsonb '{"a": [{"x": 1, "y": "one"}, {"x": 2, "y": "two", "z": [1, 2]}, {"x": "bad"}]}', '$.a[*]' COLUMNS (n FOR ORDINALITY, x int, y text))
----
1 1 one
2 2 two
3 NULL NULL

query IT rowsort
SELECT x, z FROM JSON_TABLE(jsonb '{"a": [{"x": 1, "y": "one"}, {"x": 2, "y": "two", "z": [1, 2]}, {"x": "bad"}]}', '$.a[*]' COLUMNS (x int, z jsonb PATH '$.z'))
----
1 NULL
2 [1, 2]
NULL NULL

query TT rowsort
SELECT z, zt FROM JSON_TABLE(jsonb '{"a": [{"x": 1, "y": "one"}, {"x": 2, "y": "two", "z": [1, 2]}, {"x": "bad"}]}', '$.a[*]' COLUMNS (z text FORMAT JSON PATH '$.z', zt text PATH '$.z'))
----
NULL NULL
NULL NULL
[1, 2] NULL

query TTT rowsort
SELECT * FROM JSON_TABLE(jsonb '{"a": [{"x": 1, "y": "one"}, {"x": 2, "y": "two", "z": [1, 2]}, {"x": "bad"}]}', '$.a[*]' COLUMNS (hz boolean EXISTS PATH '$.z', hy int EXISTS PATH '$.y', hx text EXISTS PATH '$.x'))
----
f 0 true
f 1 true
t 1 true

