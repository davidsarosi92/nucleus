# BM25 (PLAN.md §M14.21 T5): `score(col @@ q)` on a column with a text
# index — Lucene's formula over the index's statistics, as the statement's
# snapshot sees them.

statement ok
CREATE TABLE docs (id INT PRIMARY KEY, body TEXT)

statement ok
INSERT INTO docs VALUES
  (1, 'the quick brown fox'),
  (2, 'fox fox fox'),
  (3, 'a lazy dog'),
  (4, 'the fox and the dog and the cat'),
  (5, NULL)

# Without a text index there are no statistics.
statement error 0A000
SELECT score(body @@ 'fox') FROM docs

statement ok
CREATE INDEX docs_body ON docs USING text (body)

query IT
SELECT id, round(score(body @@ 'fox')::numeric, 6)::text FROM docs ORDER BY id
----
1 0.169845
2 0.274365
3 0.000000
4 0.122991
5 0.000000

query IT
SELECT id, round(score(body @@ 'fox dog')::numeric, 6)::text AS s FROM docs WHERE body @@ 'fox dog' ORDER BY s DESC, id
----
3 0.364814
4 0.362008
2 0.274365
1 0.169845

# The first rows by score: the index ranks them from its postings, the
# sort and the limit stay above; each row comes with its score, past the
# table's columns (`with values`, #2), which the projection reads — the
# call kept on the scan for where the index cannot rank (§M14.21 T5c).
query T
EXPLAIN SELECT id FROM docs WHERE body @@ 'fox dog' ORDER BY score(body @@ 'fox dog') DESC LIMIT 2
----
Project: #0
  Limit: 2
    Sort: #1 DESC
      Project: #0, #2
        Index Scan using docs_body on docs (body @@ 'fox dog') first 2 by text_score(body) DESC with values (rows=2)
          Subquery:
            Project: text_stats('docs', 'docs_body', 'fox dog')
              Values (1 rows)
          Subquery:
            Project: text_stats('docs', 'docs_body', 'fox dog')
              Values (1 rows)

query I
SELECT id FROM docs WHERE body @@ 'fox dog' ORDER BY score(body @@ 'fox dog') DESC LIMIT 2
----
3
4

query I
SELECT id FROM docs WHERE body @@ 'fox dog' ORDER BY score(body @@ 'fox dog') DESC LIMIT 2 OFFSET 2
----
2
1

# Ties with the last row wanted are found too: the order after the score
# decides among them.
statement ok
INSERT INTO docs VALUES (6, 'brown bear'), (7, 'brown bear'), (8, 'brown bear')

query I
SELECT id FROM docs WHERE body @@ 'bear' ORDER BY score(body @@ 'bear') DESC, id DESC LIMIT 2
----
8
7

# Another filter: the index reads its matches best first until one
# passes, and every row tied with it (§M14.21 T5a).
query T
EXPLAIN SELECT id FROM docs WHERE body @@ 'bear' AND id > 6 ORDER BY score(body @@ 'bear') DESC LIMIT 1
----
Project: #0
  Limit: 1
    Sort: #1 DESC
      Project: #0, #2
        Index Scan using docs_body on docs (body @@ 'bear') first 1 by text_score(body) DESC with values filter: (#0 > 6) (rows=1)
          Subquery:
            Project: text_stats('docs', 'docs_body', 'bear')
              Values (1 rows)
          Subquery:
            Project: text_stats('docs', 'docs_body', 'bear')
              Values (1 rows)

statement ok
DELETE FROM docs WHERE id > 5

statement ok
DROP INDEX docs_body

statement ok
CREATE INDEX docs_body ON docs USING text (body) WITH (k1 = 0.9, b = 0.4)

query TT
SELECT method, options FROM nc_catalog.indexes WHERE name = 'docs_body'
----
text {analyzer=simple,k1=0.9,b=0.4}

query IT
SELECT id, round(score(body @@ 'fox')::numeric, 6)::text FROM docs ORDER BY id
----
1 0.191761
2 0.283075
3 0.000000
4 0.163612
5 0.000000

# The query is the statement's, not the row's.
statement error 0A000
SELECT score(body @@ body) FROM docs

statement error 22023
CREATE INDEX ON docs USING text (body) WITH (b = 2)

statement error 22023
CREATE INDEX ON docs USING text (body) WITH (k1 = '-1')

statement ok
DROP TABLE docs

# A text index's matches ranked by HNSW's distance (§M14.21 T5a): few,
# the graph is searched exactly among them; many, it is searched with
# `@@` checked on each row it finds.
statement ok
CREATE TABLE notes (id INT PRIMARY KEY, body TEXT, v vector(2))

statement ok
INSERT INTO notes SELECT i, CASE WHEN i % 50 = 0 THEN 'red fox' ELSE 'grey wolf' END, ('[' || (i % 37) || ',' || (i / 37) || ']')::vector FROM generate_series(1, 2000) AS g(i)

statement ok
CREATE INDEX notes_body ON notes USING text (body)

statement ok
CREATE INDEX notes_v ON notes USING hnsw (v)

query T
EXPLAIN SELECT id FROM notes WHERE body @@ 'fox' ORDER BY v <-> '[3,4]' LIMIT 3
----
Project: #0
  Limit: 3
    Sort: #1
      Project: #0, <->(vector)(#2, [3,4])
        Index Scan using notes_v on notes (3 nearest v to [3,4] among notes_body: body @@ 'fox') (rows=3)

query I
SELECT id FROM notes WHERE body @@ 'fox' ORDER BY v <-> '[3,4]' LIMIT 3
----
150
300
450

query I
SELECT id FROM notes WHERE body @@ 'wolf' ORDER BY v <-> '[3,4]' LIMIT 1
----
151

statement ok
DROP TABLE notes

# The share of rows `@@` finds, as the planner estimates it: each word's
# documents by the index's counts, the words as independent (all: the
# product; any: one less the product of the misses) — not each kept
# sample row's text analyzed.  `fox`: 10 of 100, `dog`: 30 (all 10 of
# the foxes among them: independence misses that, as PostgreSQL's).
statement ok
CREATE TABLE words (id INT PRIMARY KEY, body TEXT)

statement ok
INSERT INTO words SELECT i, CASE WHEN i % 10 = 0 THEN 'fox dog' WHEN i % 4 = 0 THEN 'dog' ELSE 'cat' END FROM generate_series(1, 100) AS g(i)

statement ok
CREATE INDEX words_body ON words USING text (body)

statement ok
ANALYZE words

query T
EXPLAIN SELECT id FROM words WHERE body @@ 'fox'
----
Project: #0
  Index Scan using words_body on words (body @@ 'fox') (rows=10)

query T
EXPLAIN SELECT id FROM words WHERE body @@ 'fox dog'
----
Project: #0
  Index Scan using words_body on words (body @@ 'fox dog') (rows=37)

query T
EXPLAIN SELECT id FROM words WHERE body @@ '+fox +dog'
----
Project: #0
  Index Scan using words_body on words (body @@ '+fox +dog') (rows=3)

query T
EXPLAIN SELECT id FROM words WHERE body @@ 'dog -fox'
----
Project: #0
  Index Scan using words_body on words (body @@ 'dog -fox') (rows=27)

statement ok
DROP TABLE words
