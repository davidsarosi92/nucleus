# The text index (PLAN.md §M14.21 T4): `CREATE INDEX … USING text (col)
# WITH (analyzer = …)`; `col @@ q` found through it — by its analyzer,
# with or without it.

statement ok
CREATE TABLE notes (id INT PRIMARY KEY, author TEXT, body TEXT)

statement ok
INSERT INTO notes VALUES
  (1, 'ann', 'Running databases for AI models'),
  (2, 'bob', 'A database runs queries'),
  (3, 'ann', 'Engines and their runners'),
  (4, 'cy', NULL)

# Without an index: the default analyzer (`simple`), no stemming.
query I
SELECT id FROM notes WHERE body @@ 'run' ORDER BY id
----

statement ok
CREATE INDEX notes_body ON notes USING text (body) WITH (analyzer = 'english')

query TTT
SELECT method, opclasses, options FROM nc_catalog.indexes WHERE name = 'notes_body'
----
text {NULL} {analyzer=english}

# With it: the index's analyzer.
query I
SELECT id FROM notes WHERE body @@ 'run' ORDER BY id
----
1
2

query T
EXPLAIN SELECT id FROM notes WHERE body @@ 'database AND run' AND author = 'ann'
----
Project: #0
  Index Scan using notes_body on notes (body @@ 'database AND run') filter: (#1 = 'ann')

query I
SELECT id FROM notes WHERE body @@ 'database AND run' AND author = 'ann'
----
1

query I
SELECT count(*) FROM notes WHERE body @@ '-database'
----
1

query I
SELECT id FROM notes WHERE body @@ '"databases for ai"' ORDER BY id
----
1

# Kept on writes.
statement ok
UPDATE notes SET body = 'Nothing runs here' WHERE id = 1

statement ok
DELETE FROM notes WHERE id = 2

statement ok
INSERT INTO notes VALUES (5, 'dee', 'She ran; he is running')

query I
SELECT id FROM notes WHERE body @@ 'run' ORDER BY id
----
1
5

statement ok
BEGIN

statement ok
DELETE FROM notes WHERE id = 5

query I
SELECT id FROM notes WHERE body @@ 'run' ORDER BY id
----
1

statement ok
ROLLBACK

query I
SELECT id FROM notes WHERE body @@ 'run' ORDER BY id
----
1
5

query I
SELECT id FROM notes WHERE body @@ NULL
----

statement error 42601
SELECT id FROM notes WHERE body @@ '(run'

statement error 42704
CREATE INDEX ON notes USING text (body) WITH (analyzer = 'klingon')

statement error 0A000
CREATE INDEX ON notes USING text (id)

statement error 22023
CREATE INDEX ON notes USING text (body) WITH (bm25 = 1)

statement ok
DROP INDEX notes_body

# The default analyzer again: `runs`, `running` are not `run`.
query I
SELECT id FROM notes WHERE body @@ 'run' ORDER BY id
----

statement ok
DROP TABLE notes
