# An array's containment and overlap, @> <@ && (issue #24), and `by` as
# a name (an unreserved keyword).  Checked against PostgreSQL 18.

query BBBBBB
SELECT ARRAY[1,2] @> ARRAY[1], ARRAY[1,NULL] @> ARRAY[NULL::int], ARRAY[1] @> '{}', '{}'::int[] @> '{}', ARRAY[1,2] && ARRAY[2,3], ARRAY[NULL::int] && ARRAY[NULL::int]
----
true false true true true false

query BBBB
SELECT ARRAY[1] <@ ARRAY[1,1,2], ARRAY['a','b'] @> '{a}', '{b}' <@ ARRAY['a','b'], ARRAY['A'] @> ARRAY['a']
----
true true true false

query BBB
SELECT arraycontains(ARRAY[1,2], ARRAY[2]), arraycontained(ARRAY[2], ARRAY[1,2]), arrayoverlap(ARRAY[1], ARRAY[2])
----
true true false

# NULL arrays: NULL
query BB
SELECT NULL::int[] @> ARRAY[1], ARRAY[1] && NULL
----
NULL NULL

statement error 42883
SELECT ARRAY[1] @> 1

statement error 42883
SELECT 1 && 2

# Two arrays of one type
statement error 42883
SELECT ARRAY[1] @> ARRAY[true]

statement error 42883
SELECT ARRAY['a'] && ARRAY[1]

statement error 42883
SELECT arraycontains(ARRAY[1], ARRAY['a'::text])

statement ok
CREATE TABLE posts (id int PRIMARY KEY, tags text[], by text)

statement ok
INSERT INTO posts VALUES (1, ARRAY['db', 'rust'], 'ann'), (2, ARRAY['rust'], 'bo'), (3, ARRAY[]::text[], 'cy'), (4, NULL, 'di'), (5, ARRAY['db', NULL], 'ed')

query IT rowsort
SELECT id, by FROM posts WHERE tags @> ARRAY['rust']
----
1 ann
2 bo

query I rowsort
SELECT id FROM posts WHERE tags @> '{}'
----
1
2
3
5

query I rowsort
SELECT id FROM posts WHERE tags && ARRAY['db', 'go']
----
1
5

query I rowsort
SELECT id FROM posts WHERE tags <@ ARRAY['db', 'rust', 'go']
----
1
2
3

query I rowsort
SELECT id FROM posts WHERE NOT (tags && ARRAY['db'])
----
2
3

# A parameter-free array of the column's type on either side
query I rowsort
SELECT id FROM posts WHERE ARRAY['db'] <@ tags
----
1
5

query T
SELECT by FROM posts WHERE id = 3
----
cy

query I
SELECT count(*) AS by FROM posts GROUP BY by ORDER BY by LIMIT 1
----
1

statement ok
DROP TABLE posts

# A bare name in GROUP BY: a column of the FROM before an alias of the
# select list (SQL-92's rule; ORDER BY prefers the alias)
statement ok
CREATE TABLE g (id int PRIMARY KEY, x int)

statement ok
INSERT INTO g VALUES (1, 5), (2, 5), (3, 6)

query II rowsort
SELECT count(*) AS x, min(id) FROM g GROUP BY x
----
1 3
2 1

statement error 42803
SELECT id % 2 AS x, count(*) FROM g GROUP BY x

query I
SELECT x * 10 AS x FROM g GROUP BY x ORDER BY x
----
50
60

query II rowsort
SELECT id % 2 AS y, count(*) FROM g GROUP BY y
----
0 1
1 2

statement ok
DROP TABLE g
