# Task queues (PLAN.md §M16.5 S5): tasks taken under a lease, finished in
# the transaction of their work, retried with backoff, dead letters past
# their attempts.  nucleus-only.

statement ok
CREATE QUEUE jobs (kind TEXT NOT NULL, n INT DEFAULT 0, UNIQUE (kind, n)) WITH (max_attempts = 3, backoff = '1 hour', max_backoff = '3 hours')

statement ok
CREATE QUEUE IF NOT EXISTS jobs (kind TEXT)

statement error 42P07
CREATE QUEUE jobs (kind TEXT)

# Its dead letters' name is taken
statement error 42P07
CREATE QUEUE jobs_dead (kind TEXT)

statement error 42701
CREATE QUEUE bad (attempts INT)

statement error 0A000
CREATE QUEUE bad (k INT PRIMARY KEY)

statement error 22023
CREATE QUEUE bad (k INT) WITH (lease = 'soon')

statement error 22023
CREATE QUEUE bad (k INT) WITH (max_attempts = 0)

statement error 22023
CREATE QUEUE bad (k INT) WITH (visibility = '1 minute')

query TT
SELECT name, dead_letter FROM nc_catalog.queues ORDER BY name
----
jobs jobs_dead

query TITT
SELECT lease, max_attempts, backoff, max_backoff FROM nc_catalog.queues
----
00:00:30 3 01:00:00 03:00:00

# Nothing to take
query II
TAKE FROM jobs
----

statement ok
INSERT INTO jobs (kind, n) VALUES ('mail', 1), ('mail', 2), ('mail', 3)

# A unique key: a task added twice is refused (an idempotency key)
statement error 23505
INSERT INTO jobs (kind, n) VALUES ('mail', 1)

# The queue's own values: given by default, the key by the queue
statement error 428C9
INSERT INTO jobs (id, kind) VALUES (100, 'x')

statement ok
INSERT INTO jobs (kind, priority) VALUES ('urgent', -10)

statement ok
INSERT INTO jobs (kind, priority, available_at) VALUES ('later', -20, now() + interval '1 day')

query IIITT
SELECT id, priority, attempts, taken_at IS NULL, last_error IS NULL FROM jobs ORDER BY id
----
1 0 0 t t
2 0 0 t t
3 0 0 t t
5 -10 0 t t
6 -20 0 t t

# Lower priority first; a delayed task not yet (4: the key the refused
# insert drew, as a sequence's)
query IITI
TAKE FROM jobs
----
5 1 urgent 0

query IIT
TAKE id, kind FROM jobs LIMIT 2 LEASE '10 minutes'
----
1 1 mail
2 1 mail

query IIITT
SELECT id, attempts, available_at > now() + interval '9 minutes', taken_at IS NOT NULL, available_at < now() + interval '11 minutes' FROM jobs WHERE id IN (1, 2) ORDER BY id
----
1 1 t t t
2 1 t t t

# Its own columns, given by name; a limit of 0
query II
TAKE FROM jobs LIMIT 0
----

query IIII
TAKE n, priority FROM jobs LIMIT 1
----
3 1 3 0

# Nothing left: taken or delayed
query II
TAKE FROM jobs LIMIT 10
----

