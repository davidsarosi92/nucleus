# A secondary index's range read in its order (the queue's take reads
# through it): only where its columns are never NULL (a NULL's key sorts
# first, ORDER BY's last)
statement ok
CREATE TABLE ordered (id INT PRIMARY KEY, v INT, w INT NOT NULL)

statement ok
CREATE INDEX ordered_wv ON ordered (w, v)

statement ok
INSERT INTO ordered VALUES (1, NULL, 3), (2, 5, 1), (3, 1, 2), (4, 3, 1), (5, NULL, 1)

query I
SELECT id FROM ordered WHERE w = 1 ORDER BY w, v
----
4
2
5

query I
SELECT id FROM ordered WHERE w >= 1 ORDER BY w, v, id
----
4
2
5
3
1

statement ok
CREATE TABLE ordered2 (id INT PRIMARY KEY, a INT NOT NULL, b INT NOT NULL)

statement ok
CREATE INDEX ordered2_a ON ordered2 (a)

statement ok
