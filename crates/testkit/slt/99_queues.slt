# Finished in the work's transaction: rolled back, it stays
statement ok
CREATE TABLE sent (task BIGINT PRIMARY KEY)

statement ok
BEGIN

statement ok
INSERT INTO sent VALUES (1)

statement ok
FINISH TASK 1 OF jobs ATTEMPT 1

statement ok
ROLLBACK

query I
SELECT count(*) FROM jobs WHERE id = 1
----
1

statement ok
BEGIN

statement ok
INSERT INTO sent VALUES (1)

statement ok
FINISH TASK 1 OF jobs ATTEMPT 1

statement ok
COMMIT

query II
SELECT (SELECT count(*) FROM jobs WHERE id = 1), (SELECT count(*) FROM sent)
----
0 1

# Not there any more; not this attempt's; not taken
statement error 55000
FINISH TASK 1 OF jobs ATTEMPT 1

statement error 55000
FINISH TASK 2 OF jobs ATTEMPT 2

statement error 55000
FINISH TASK 6 OF jobs ATTEMPT 0

statement error 55000
FAIL TASK 6 OF jobs ATTEMPT 1

statement error 22023
FINISH TASK NULL OF jobs ATTEMPT 1

statement error 42809
FINISH TASK 1 OF sent ATTEMPT 1

# Failed: the backoff, 1 hour on the first attempt
statement ok
FAIL TASK 2 OF jobs ATTEMPT 1 ERROR 'smtp down'

statement error
FAIL TASK 2 OF jobs ATTEMPT 1

query ITTT
SELECT attempts, taken_at IS NULL, last_error, available_at BETWEEN now() + interval '59 minutes' AND now() + interval '1 hour' FROM jobs WHERE id = 2
----
1 t smtp down t

# Its lease run out: available again, the next attempt
statement ok
UPDATE jobs SET available_at = now() - interval '1 second' WHERE id IN (2, 3)

query IIT
TAKE id, kind FROM jobs LIMIT 2
----
2 2 mail
3 2 mail

# Attempt 1 lost task 3 to attempt 2: refused, and attempt 2 finishes it
statement error 55000
FINISH TASK 3 OF jobs ATTEMPT 1

statement ok
FINISH TASK 3 OF jobs ATTEMPT 2

# The backoff doubles: 2 hours on the second attempt; RETRY AFTER chooses
statement ok
FAIL TASK 2 OF jobs ATTEMPT 2

query T
SELECT available_at BETWEEN now() + interval '119 minutes' AND now() + interval '2 hours' FROM jobs WHERE id = 2
----
t

statement ok
UPDATE jobs SET available_at = now() - interval '1 second' WHERE id = 2

query IIT
TAKE id, kind FROM jobs
----
2 3 mail

# Past max_attempts: a dead letter, with its columns
