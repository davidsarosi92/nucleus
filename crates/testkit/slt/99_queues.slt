2 1 2

# A column added since: the dead letters keep the columns they have
statement ok
ALTER TABLE q3 ADD COLUMN extra TEXT

query TT
FAIL TASK 2 OF q3 ATTEMPT 1
----
dead NULL

query III
SELECT task_id, k, attempts FROM q3_dead ORDER BY seq
----
1 1 1
2 2 1

statement ok
DROP QUEUE q3

