# nucleus's own system catalog, nc_catalog.  (The PostgreSQL compatibility
# views are pg-compat's: tests/slt-pg.)

statement ok
CREATE TABLE p (id BIGINT PRIMARY KEY, name TEXT NOT NULL DEFAULT 'x', score DOUBLE PRECISION CHECK (score >= 0))

statement ok
CREATE TABLE c (id BIGINT PRIMARY KEY, pid BIGINT REFERENCES p (id) ON DELETE CASCADE, note VARCHAR(20) UNIQUE, amount NUMERIC(10, 2))

statement ok
CREATE INDEX c_pid ON c (pid)

statement ok
CREATE TABLE log (msg TEXT)

# nc_catalog
query ITITBIIIIT
SELECT table_id, name, columns, primary_key, has_row_id, indexes, checks, foreign_keys, referenced_by, key_prefix FROM nc_catalog.tables ORDER BY table_id
----
1 p 3 {id} false 0 1 0 1 0100000001
2 c 4 {id} false 2 0 1 0 0100000002
3 log 1 {} true 0 0 0 0 0100000003

query TITTBTB
SELECT table_name, position, name, type, nullable, default_expr, in_primary_key FROM nc_catalog.columns WHERE table_id < 3 ORDER BY table_id, position
----
p 1 id bigint false NULL true
p 2 name text false 'x' false
p 3 score double precision true NULL false
c 1 id bigint false NULL true
c 2 pid bigint true NULL false
c 3 note varchar(20) true NULL false
c 4 amount numeric(10,2) true NULL false

query TITTBBT
SELECT table_name, index_id, name, columns, is_unique, is_primary, key_prefix FROM nc_catalog.indexes ORDER BY table_name, index_id
----
c 0 c_pkey {id} true true 010000000200000000
c 1 c_note_key {note} true false 010000000200000001
c 2 c_pid {pid} false false 010000000200000002
p 0 p_pkey {id} true true 010000000100000000

query TTTT rowsort
SELECT table_name, name, kind, definition FROM nc_catalog.constraints
----
c c_note_key unique UNIQUE (note)
c c_pid_fkey foreign key FOREIGN KEY (pid) REFERENCES p(id) ON DELETE CASCADE
c c_pkey primary key PRIMARY KEY (id)
p p_pkey primary key PRIMARY KEY (id)
p p_score_check check CHECK (score >= 0)

query TTTTTTT
SELECT table_name, name, columns, referenced_table, referenced_columns, on_delete, on_update FROM nc_catalog.foreign_keys
----
c c_pid_fkey {pid} p {id} cascade no action

statement ok
INSERT INTO p VALUES (1, 'a', 1.5), (2, 'b', NULL), (3, 'b', 7)

statement ok
ANALYZE p

query TIII
SELECT column_name, rows, nulls, distinct_values FROM nc_catalog.statistics WHERE table_name = 'p' ORDER BY column_name
----
id 3 0 3
name 3 0 2
score 3 1 2

query I
SELECT analyzed_rows FROM nc_catalog.tables WHERE name = 'p'
----
3

query T
SELECT name FROM nc_catalog.schemas WHERE name IN ('nc_catalog', 'public') ORDER BY name
----
nc_catalog
public

