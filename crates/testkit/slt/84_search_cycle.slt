# A recursive query's SEARCH and CYCLE clauses (PLAN.md §M14.34 G2,
# issue #16): the order of a tree's walk, and a graph's cycles ended.

statement ok
CREATE TABLE tree (id int PRIMARY KEY, parent int)

statement ok
INSERT INTO tree VALUES (1, NULL), (2, 1), (3, 1), (4, 2), (5, 2), (6, 3)

statement ok
CREATE TABLE g (f int, t int)

statement ok
INSERT INTO g VALUES (1, 2), (2, 3), (3, 1), (3, 4)

# Depth first: the path of ROW(id) from the root, a record[].
query IIT
WITH RECURSIVE r (id, lvl) AS (SELECT id, 0 FROM tree WHERE parent IS NULL UNION ALL SELECT tree.id, r.lvl + 1 FROM tree JOIN r ON tree.parent = r.id) SEARCH DEPTH FIRST BY id SET ord SELECT * FROM r ORDER BY ord
----
1 0 {(1)}
2 1 {(1),(2)}
4 2 {(1),(2),(4)}
5 2 {(1),(2),(5)}
3 1 {(1),(3)}
6 2 {(1),(3),(6)}

# Breadth first: ROW(depth, id); the depth is not one of r's columns.
query IIT
WITH RECURSIVE r (id, lvl) AS (SELECT id, 0 FROM tree WHERE parent IS NULL UNION ALL SELECT tree.id, r.lvl + 1 FROM tree JOIN r ON tree.parent = r.id) SEARCH BREADTH FIRST BY id SET ord SELECT * FROM r ORDER BY ord
----
1 0 (0,1)
2 1 (1,2)
3 1 (1,3)
4 2 (2,4)
5 2 (2,5)
6 2 (2,6)

# Two columns, the CTE under an alias, a comma join.
query IT
WITH RECURSIVE r (id, lvl) AS (SELECT id, 0 FROM tree WHERE parent IS NULL UNION ALL SELECT x.id, r.lvl + 1 FROM tree AS x, r WHERE x.parent = r.id) SEARCH DEPTH FIRST BY lvl, id SET s SELECT id, s FROM r ORDER BY s DESC
----
6 {"(0,1)","(1,3)","(2,6)"}
3 {"(0,1)","(1,3)"}
5 {"(0,1)","(1,2)","(2,5)"}
4 {"(0,1)","(1,2)","(2,4)"}
2 {"(0,1)","(1,2)"}
1 {"(0,1)"}

# CYCLE: the row closing a cycle is given, marked, and not followed.
query IIBT rowsort
WITH RECURSIVE p (f, t) AS (SELECT f, t FROM g WHERE f = 1 UNION ALL SELECT g.f, g.t FROM g, p WHERE g.f = p.t) CYCLE f SET seen USING path SELECT * FROM p
----
1 2 false {(1)}
1 2 true {(1),(2),(3),(1)}
2 3 false {(1),(2)}
3 1 false {(1),(2),(3)}
3 4 false {(1),(2),(3)}

query IITT rowsort
WITH RECURSIVE p (f, t) AS (SELECT f, t FROM g WHERE f = 1 UNION ALL SELECT g.f, g.t FROM g, p WHERE g.f = p.t) CYCLE f, t SET seen TO 'Y' DEFAULT 'N' USING path SELECT * FROM p
----
1 2 N {"(1,2)"}
1 2 Y {"(1,2)","(2,3)","(3,1)","(1,2)"}
2 3 N {"(1,2)","(2,3)"}
3 1 N {"(1,2)","(2,3)","(3,1)"}
3 4 N {"(1,2)","(2,3)","(3,4)"}

query II
WITH RECURSIVE p (f, t) AS (SELECT f, t FROM g WHERE f = 1 UNION SELECT g.f, g.t FROM g, p WHERE g.f = p.t) CYCLE t SET seen USING path SELECT count(*), count(*) FILTER (WHERE seen) FROM p
----
5 1

query T
WITH RECURSIVE p (f, t) AS (SELECT f, t FROM g WHERE f = 1 UNION ALL SELECT g.f, g.t FROM g, p WHERE g.f = p.t) CYCLE f SET seen USING path SELECT path FROM p WHERE seen
----
{(1),(2),(3),(1)}

# The step's own condition kept beside the mark's.
query II rowsort
WITH RECURSIVE p (f, t) AS (SELECT f, t FROM g WHERE f = 1 UNION ALL SELECT g.f, g.t FROM g, p WHERE g.f = p.t AND g.t < 4) CYCLE f SET seen TO 1 DEFAULT 0 USING path SELECT f, seen FROM p
----
1 0
1 1
2 0
3 0

# Both.
query IITB
WITH RECURSIVE p (f, t) AS (SELECT f, t FROM g WHERE f = 1 UNION ALL SELECT g.f, g.t FROM g, p WHERE g.f = p.t) SEARCH BREADTH FIRST BY f SET o CYCLE f SET seen USING path SELECT f, t, o, seen FROM p ORDER BY o, t
----
1 2 (0,1) false
2 3 (1,2) false
3 1 (2,3) false
3 4 (2,3) false
1 2 (3,1) true

query IIT
WITH RECURSIVE p (f, t) AS (SELECT f, t FROM g WHERE f = 1 UNION ALL SELECT g.f, g.t FROM g, p WHERE g.f = p.t) SEARCH DEPTH FIRST BY f SET o CYCLE f SET seen USING path SELECT f, t, o FROM p WHERE NOT seen ORDER BY o
----
1 2 {(1)}
2 3 {(1),(2)}
3 1 {(1),(2),(3)}
3 4 {(1),(2),(3)}

query IT
WITH RECURSIVE r (id) AS (SELECT 1 UNION ALL SELECT id + 1 FROM r WHERE id < 3) SEARCH DEPTH FIRST BY id SET o SELECT * FROM r ORDER BY o DESC
----
3 {(1),(2),(3)}
2 {(1),(2)}
1 {(1)}

