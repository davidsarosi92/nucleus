# The system catalogs: nucleus's own nc_catalog, and the PostgreSQL
# compatibility views (pg_catalog, information_schema) psql and drivers use.

statement ok
CREATE TABLE p (id BIGINT PRIMARY KEY, name TEXT NOT NULL DEFAULT 'x', score DOUBLE PRECISION CHECK (score >= 0))

statement ok
CREATE TABLE c (id BIGINT PRIMARY KEY, pid BIGINT REFERENCES p (id) ON DELETE CASCADE, note VARCHAR(20) UNIQUE, amount NUMERIC(10, 2))

statement ok
CREATE INDEX c_pid ON c (pid)

statement ok
CREATE TABLE log (msg TEXT)

# nc_catalog
query ITITBIIIIT
SELECT table_id, name, columns, primary_key, has_row_id, indexes, checks, foreign_keys, referenced_by, key_prefix FROM nc_catalog.tables ORDER BY table_id
----
1 p 3 {id} false 0 1 0 1 0100000001
2 c 4 {id} false 2 0 1 0 0100000002
3 log 1 {} true 0 0 0 0 0100000003

query TITTBTB
SELECT table_name, position, name, type, nullable, default_expr, in_primary_key FROM nc_catalog.columns WHERE table_id < 3 ORDER BY table_id, position
----
p 1 id bigint false NULL true
p 2 name text false 'x' false
p 3 score double precision true NULL false
c 1 id bigint false NULL true
c 2 pid bigint true NULL false
c 3 note varchar(20) true NULL false
c 4 amount numeric(10,2) true NULL false

query TITTBBT
SELECT table_name, index_id, name, columns, is_unique, is_primary, key_prefix FROM nc_catalog.indexes ORDER BY table_name, index_id
----
c 0 c_pkey {id} true true 010000000200000000
c 1 c_note_key {note} true false 010000000200000001
c 2 c_pid {pid} false false 010000000200000002
p 0 p_pkey {id} true true 010000000100000000

query TTTT rowsort
SELECT table_name, name, kind, definition FROM nc_catalog.constraints
----
c c_note_key unique UNIQUE (note)
c c_pid_fkey foreign key FOREIGN KEY (pid) REFERENCES p(id) ON DELETE CASCADE
c c_pkey primary key PRIMARY KEY (id)
p p_pkey primary key PRIMARY KEY (id)
p p_score_check check CHECK (score >= 0)

query TTTTTTT
SELECT table_name, name, columns, referenced_table, referenced_columns, on_delete, on_update FROM nc_catalog.foreign_keys
----
c c_pid_fkey {pid} p {id} cascade no action

statement ok
INSERT INTO p VALUES (1, 'a', 1.5), (2, 'b', NULL), (3, 'b', 7)

statement ok
ANALYZE p

query TIII
SELECT column_name, rows, nulls, distinct_values FROM nc_catalog.statistics WHERE table_name = 'p' ORDER BY column_name
----
id 3 0 3
name 3 0 2
score 3 1 2

query I
SELECT analyzed_rows FROM nc_catalog.tables WHERE name = 'p'
----
3

query T
SELECT name FROM nc_catalog.schemas ORDER BY name
----
information_schema
nc_catalog
pg_catalog
public

statement error 42501
INSERT INTO nc_catalog.tables VALUES (9)

# pg_catalog, as psql's \d queries it.
query TTT
SELECT n.nspname, c.relname, c.relkind FROM pg_catalog.pg_class c LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'public' ORDER BY 2
----
public c r
public c_note_key i
public c_pid i
public c_pkey i
public log r
public p r
public p_pkey i

query T
SELECT c.relname FROM pg_catalog.pg_class c WHERE c.relname OPERATOR(pg_catalog.~) '^(c)$' COLLATE pg_catalog.default AND pg_catalog.pg_table_is_visible(c.oid)
----
c

query TTBT
SELECT a.attname, pg_catalog.format_type(a.atttypid, a.atttypmod), a.attnotnull, (SELECT pg_catalog.pg_get_expr(d.adbin, d.adrelid, true) FROM pg_catalog.pg_attrdef d WHERE d.adrelid = a.attrelid AND d.adnum = a.attnum AND a.atthasdef) FROM pg_catalog.pg_attribute a WHERE a.attrelid = 'p'::regclass AND a.attnum > 0 ORDER BY a.attnum
----
id bigint true NULL
name text true 'x'
score double precision false NULL

query TT
SELECT conname, pg_catalog.pg_get_constraintdef(oid, true) FROM pg_catalog.pg_constraint WHERE conrelid = 'c'::regclass ORDER BY 1
----
c_note_key UNIQUE (note)
c_pid_fkey FOREIGN KEY (pid) REFERENCES p(id) ON DELETE CASCADE
c_pkey PRIMARY KEY (id)

query TT
SELECT conname, conrelid::pg_catalog.regclass FROM pg_catalog.pg_constraint c WHERE confrelid IN (SELECT pg_catalog.pg_partition_ancestors('p'::regclass) UNION ALL VALUES ('p'::pg_catalog.regclass)) AND contype = 'f'
----
c_pid_fkey c

query T
SELECT pg_catalog.pg_get_indexdef(i.indexrelid, 0, true) FROM pg_catalog.pg_index i WHERE i.indrelid = 'c'::regclass ORDER BY 1
----
CREATE INDEX c_pid ON public.c USING btree (pid)
CREATE UNIQUE INDEX c_note_key ON public.c USING btree (note)
CREATE UNIQUE INDEX c_pkey ON public.c USING btree (id)

# Empty catalogs still bind the array-heavy queries psql sends.
query T
SELECT CASE WHEN pol.polroles = '{0}' THEN NULL ELSE pg_catalog.array_to_string(array(select rolname from pg_catalog.pg_roles where oid = any (pol.polroles) order by 1), ',') END FROM pg_catalog.pg_policy pol
----

query T
SELECT 'd' = any(stxkind) FROM pg_catalog.pg_statistic_ext WHERE stxrelid = 'c'::regclass
----

query TTT
SELECT nspname, pg_catalog.pg_get_userbyid(nspowner), current_user FROM pg_catalog.pg_namespace WHERE nspname = 'public'
----
public nucleus nucleus

# information_schema
query TT
SELECT table_name, table_type FROM information_schema.tables WHERE table_schema = 'public' ORDER BY 1
----
c BASE TABLE
log BASE TABLE
p BASE TABLE

query TITTI
SELECT table_name, ordinal_position, column_name, data_type, character_maximum_length FROM information_schema.columns WHERE table_name = 'c' ORDER BY 2
----
c 1 id bigint NULL
c 2 pid bigint NULL
c 3 note character varying 20
c 4 amount numeric NULL

query TTT rowsort
SELECT constraint_name, table_name, constraint_type FROM information_schema.table_constraints WHERE table_name = 'c'
----
c_note_key c UNIQUE
c_pid_fkey c FOREIGN KEY
c_pkey c PRIMARY KEY

# A user table shadows a catalog table of the same unqualified name.
statement ok
CREATE TABLE pg_class (x INT)

query I
SELECT count(*) FROM pg_class
----
0

query T
SELECT relname FROM pg_catalog.pg_class WHERE relname = 'pg_class' ORDER BY relname
----
pg_class
pg_class

