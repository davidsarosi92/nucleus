query TT
SELECT avg(x), avg(y) FROM (VALUES (1, 1.5), (2, 2.25)) v (x, y)
----
1.5000000000000000 1.8750000000000000

query TT
SELECT 12345678901234567890 + 1, -9223372036854775808
----
12345678901234567891 -9223372036854775808

query T
SELECT coalesce(NULL, 1, 2.5)
----
1

query T
SELECT CASE WHEN true THEN 1 ELSE 2.50 END
----
