# NUMERIC / DECIMAL: exact decimals (results checked against PostgreSQL 16).

# Decimal literals are numeric; the scale is kept as written.
query TTT
SELECT 1.50, -0.05, 1.5e3
----
1.50 -0.05 1500

query TTTT
SELECT 1 + 1.5, 1.50 * 2.0, 10 / 4.0, 7.5 % 2
----
2.5 3.000 2.5000000000000000 1.5

# Division keeps at least 16 significant digits.
query TTT
SELECT 1 / 3.0, 2 / 3.0, 100 / 7.0
----
0.33333333333333333333 0.66666666666666666667 14.2857142857142857

query TT
SELECT 1.5 + 1::float8, 0.1 + 0.2
----
2.5 0.3

query BBB
SELECT 0.1 + 0.2 = 0.3, 1.0 = 1, 1.5 > 1
----
true true true

statement ok
CREATE TABLE acct (id INT PRIMARY KEY, balance NUMERIC(10, 2) NOT NULL, rate DECIMAL(5, 4), note NUMERIC)

statement ok
INSERT INTO acct VALUES (1, 100.005, 0.0525, 1.10), (2, 0.1, NULL, 12345678901234567890.123), (3, -42, 1, NULL)

query ITTT rowsort
SELECT id, balance, rate, note FROM acct
----
1 100.01 0.0525 1.10
2 0.10 NULL 12345678901234567890.123
3 -42.00 1.0000 NULL

statement error 22003
INSERT INTO acct VALUES (4, 123456789.00, 0, 0)

statement error 22003
UPDATE acct SET rate = 10 WHERE id = 1

query TT
SELECT sum(balance), avg(balance) FROM acct
----
58.11 19.3700000000000000

query TTT
SELECT min(balance), max(balance), sum(balance * rate) FROM acct
----
-42.00 100.01 -36.749475

query T
SELECT balance FROM acct WHERE balance > 0.1 ORDER BY 1
----
100.01

query T
SELECT balance FROM acct WHERE balance = 100.01
----
100.01

query IT
SELECT id, balance * 2 FROM acct WHERE balance BETWEEN -50 AND 0.1 ORDER BY id
----
2 0.20
3 -84.00

# Rounding is half away from zero.
query TTTTT
SELECT round(2.5), round(-2.5), round(1.235, 2), round(1234.5, -2), round(1.2, 3)
----
3 -3 1.24 1200 1.200

query TTTT
SELECT trunc(-1.79), trunc(1.789, 2), floor(-1.2), ceil(1.2)
----
-1 1.78 -2 2

query TTT
SELECT abs(-1.50), sign(-3.2), mod(7.5, 2)
----
1.50 -1 1.5

query TTTT
SELECT 123.456::numeric(5, 2), '1.5'::numeric, CAST(2 AS decimal), 7::numeric / 2
----
123.46 1.5 2 3.5000000000000000

query IRT
SELECT 2.7::int, 2.5::float8, 0.1::float8::numeric
----
3 2.500 0.1

statement error 22003
SELECT 999.995::numeric(5, 2)

statement error 22012
SELECT 1.0 / 0

statement error 22P02
SELECT 'abc'::numeric

# Equal values of different scale are equal in DISTINCT, GROUP BY and keys.
query T
SELECT DISTINCT x FROM (VALUES (1.0), (1.00), (1)) v (x)
----
1.0

query TI
SELECT x, count(*) FROM (VALUES (2.50), (2.5), (3)) v (x) GROUP BY x ORDER BY x
----
2.50 2
3 1

statement ok
CREATE TABLE prices (p NUMERIC PRIMARY KEY)

statement ok
INSERT INTO prices VALUES (1.5), (-2), (0), (10.25), (-0.5)

