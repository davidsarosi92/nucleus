# FULL [OUTER] JOIN (results checked against PostgreSQL 16).

statement ok
CREATE TABLE l (id INT, a TEXT)

statement ok
CREATE TABLE r (id INT, b TEXT)

statement ok
INSERT INTO l VALUES (1, 'l1'), (2, 'l2'), (2, 'l2b'), (NULL, 'lnull')

statement ok
INSERT INTO r VALUES (2, 'r2'), (3, 'r3'), (NULL, 'rnull')

query TT
SELECT l.a, r.b FROM l FULL JOIN r ON l.id = r.id ORDER BY 1, 2
----
l1 NULL
l2 r2
l2b r2
lnull NULL
NULL r3
NULL rnull

# An ON condition on one side does not filter either side.
query TT
SELECT l.a, r.b FROM l FULL OUTER JOIN r ON l.id = r.id AND r.b = 'r3' ORDER BY 1, 2
----
l1 NULL
l2 NULL
l2b NULL
lnull NULL
NULL r2
NULL r3
NULL rnull

# USING merges the columns: the first non-NULL of the two, listed first.
query ITT
SELECT * FROM l FULL JOIN r USING (id) ORDER BY 1, 2, 3
----
1 l1 NULL
2 l2 r2
2 l2b r2
3 NULL r3
NULL lnull NULL
NULL NULL rnull

query ITT
SELECT id, a, b FROM l FULL JOIN r USING (id) WHERE id IS NOT NULL ORDER BY 1, 2
----
1 l1 NULL
2 l2 r2
2 l2b r2
3 NULL r3

query III
SELECT l.id, r.id, id FROM l FULL JOIN r USING (id) ORDER BY 1, 2, 3
----
1 NULL 1
2 2 2
2 2 2
NULL 3 3
NULL NULL NULL
NULL NULL NULL

# WHERE runs after the join (filters are not pushed below it).
query TT
SELECT l.a, r.b FROM l FULL JOIN r ON l.id = r.id WHERE l.a IS NULL ORDER BY 2
----
NULL r3
NULL rnull

query TT
SELECT l.a, r.b FROM l FULL JOIN r ON true WHERE r.b = 'r3' ORDER BY 1
----
l1 r3
l2 r3
l2b r3
lnull r3

query I
SELECT count(*) FROM l FULL JOIN r ON false
----
7

query TT
SELECT l.a, r.b FROM l FULL JOIN (SELECT * FROM r WHERE false) r ON l.id = r.id ORDER BY 1
----
l1 NULL
l2 NULL
l2b NULL
lnull NULL

query TTT
SELECT x.a, x.b, t.v FROM (SELECT * FROM l FULL JOIN r USING (id)) x FULL JOIN (VALUES (3, 'v3'), (9, 'v9')) t(id, v) ON x.id = t.id ORDER BY 1, 2, 3
----
l1 NULL NULL
l2 r2 NULL
l2b r2 NULL
lnull NULL NULL
NULL r3 v3
NULL rnull NULL
NULL NULL v9

# PostgreSQL needs an equality to run a FULL JOIN; nucleus also runs other
# conditions (nested loop).
query TT
SELECT coalesce(l.a, '-'), coalesce(r.b, '-') FROM l FULL JOIN r ON l.id < r.id ORDER BY 1, 2
----
- rnull
l1 r2
l1 r3
l2 r3
l2b r3
lnull -

query T
EXPLAIN SELECT l.a, r.b FROM l FULL JOIN r ON l.id = r.id WHERE l.a = 'l1'
----
Project: #1, #3
  Filter: (#1 = 'l1')
    Full Hash Join (#0 = #0) on (#0 = #2)
      Seq Scan on l
      Seq Scan on r

# Column alias lists (PostgreSQL's `AS t (a, b)`).
query IT
SELECT t.n, t.word FROM (VALUES (1, 'one')) AS t (n, word)
----
1 one

query IT
SELECT x, a FROM l AS q (x) WHERE x = 1
----
1 l1

statement error 42P10
SELECT * FROM l AS q (x, y, z)
