# Composite primary keys and range scans on them.
statement ok
CREATE TABLE events (day INT, seq INT, what TEXT, PRIMARY KEY (day, seq))

statement ok
INSERT INTO events VALUES (1, 1, 'a'), (1, 2, 'b'), (2, 1, 'c'), (2, 2, 'd'), (3, 1, 'e')

query T
SELECT what FROM events WHERE day = 2 ORDER BY seq
----
c
d

query T
SELECT what FROM events WHERE day = 1 AND seq >= 2
----
b

statement error 23505
INSERT INTO events VALUES (2, 2, 'dup')
