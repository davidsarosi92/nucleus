query I rowsort
SELECT id FROM items WHERE price >= 20
----
1
2
3

query I
SELECT id FROM items WHERE price = 10
----

statement error 23505
UPDATE items SET sku = 'b2' WHERE id = 1

statement ok
UPDATE items SET sku = 'zz' WHERE id = 1

query I
SELECT id FROM items WHERE sku = 'zz'
----
