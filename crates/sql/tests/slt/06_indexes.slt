# Secondary indexes: lookups, ranges, maintenance on writes, uniqueness.

statement ok
CREATE TABLE items (id INT PRIMARY KEY, sku TEXT, price INT, cat TEXT)

statement ok
INSERT INTO items VALUES (1, 'a1', 10, 'x'), (2, 'b2', 20, 'y'), (3, 'c3', 30, 'x'), (4, 'd4', NULL, 'y')

statement ok
CREATE INDEX items_price ON items (price)

statement ok
CREATE UNIQUE INDEX items_sku ON items (sku)

statement ok
CREATE INDEX items_cat_price ON items (cat, price)

query I rowsort
SELECT id FROM items WHERE price >= 20
----
2
3

query I
SELECT id FROM items WHERE price > 10 AND price < 30
----
2

query I
SELECT id FROM items WHERE sku = 'c3'
----
3

query I rowsort
SELECT id FROM items WHERE cat = 'y'
----
2
4

query I
SELECT id FROM items WHERE cat = 'x' AND price > 15
----
3

query T
EXPLAIN SELECT id FROM items WHERE sku = 'c3'
----
Project: #0
  Index Scan using items_sku on items (sku = 'c3') filter: (#1 = 'c3')

query T
EXPLAIN SELECT id FROM items WHERE id = 2
----
Project: #0
  Index Scan using primary key on items (id = 2) filter: (#0 = 2)

statement error 23505
INSERT INTO items VALUES (5, 'a1', 5, 'z')

# NULLs are not equal to each other: no uniqueness conflict.
statement ok
INSERT INTO items VALUES (6, NULL, 1, 'z'), (7, NULL, 2, 'z')

statement ok
