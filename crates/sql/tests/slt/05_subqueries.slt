# Scalar, EXISTS and IN subqueries, correlated and not; FROM subqueries; UNION.

statement ok
CREATE TABLE t (id INT PRIMARY KEY, grp INT, v INT)

statement ok
INSERT INTO t VALUES (1, 1, 10), (2, 1, 20), (3, 2, 5), (4, 3, NULL)

query I
SELECT (SELECT max(v) FROM t)
----
20

query I rowsort
SELECT id FROM t WHERE v > (SELECT avg(v) FROM t)
----
2

# Correlated: rows above their group's average.
query I
SELECT id FROM t a WHERE v > (SELECT avg(v) FROM t b WHERE b.grp = a.grp) ORDER BY id
----
2

query I rowsort
SELECT id FROM t a WHERE EXISTS (SELECT 1 FROM t b WHERE b.grp = a.grp AND b.id <> a.id)
----
1
2

query I rowsort
SELECT id FROM t WHERE grp IN (SELECT grp FROM t WHERE v >= 20)
----
1
2

query I rowsort
SELECT id FROM t WHERE grp NOT IN (SELECT grp FROM t WHERE v IS NOT NULL)
----
4

# NOT IN with a NULL in the list is never true.
query I
SELECT count(*) FROM t WHERE 99 NOT IN (SELECT v FROM t)
----
0

query II
SELECT g, n FROM (SELECT grp AS g, count(*) AS n FROM t GROUP BY grp) s WHERE n > 1
----
1 2

statement error 21000
SELECT (SELECT v FROM t)

query I
SELECT (SELECT v FROM t WHERE id = 99)
----
NULL

query I
SELECT id FROM t UNION SELECT grp FROM t ORDER BY 1
----
1
2
3
4

query I
SELECT grp FROM t UNION ALL SELECT grp FROM t WHERE grp > 1 ORDER BY 1
----
1
1
2
2
3
3

query IT
VALUES (2, 'b'), (1, 'a') ORDER BY 1
----
1 a
2 b

query IT
SELECT * FROM (VALUES (1, 'x'), (2, 'y')) AS v WHERE column1 > 1
----
2 y
