{
  "name": "nucleus-db",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript driver for the nucleus database (the nucleus protocol, ncp); in a browser, the database itself in WebAssembly",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src",
    "wasm/nucleus.wasm"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/nucleus.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidsarosi92/nucleus.git",
    "directory": "drivers/js"
  }
}
