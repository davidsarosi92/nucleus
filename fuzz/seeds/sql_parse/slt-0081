SELECT row_number() OVER (ORDER BY rank() OVER ()) FROM emp;
SELECT upper('a') OVER () FROM emp;
SELECT row_number() OVER nope FROM emp;
SELECT row_number() OVER (w PARTITION BY id) FROM emp WINDOW w AS (PARTITION BY dept);
SELECT row_number() OVER (w ORDER BY id) FROM emp WINDOW w AS (ORDER BY dept);
SELECT sum(id) OVER (ORDER BY hired, id RANGE 1 PRECEDING) FROM emp;
SELECT sum(id) OVER (GROUPS 1 PRECEDING) FROM emp;
SELECT sum(id) OVER (ORDER BY id ROWS BETWEEN CURRENT ROW AND 1 PRECEDING) FROM emp;
SELECT sum(id) OVER (ORDER BY id ROWS UNBOUNDED FOLLOWING) FROM emp;
SELECT sum(id) OVER (ORDER BY id ROWS -1 PRECEDING) FROM emp;
SELECT sum(id) OVER (ORDER BY salary RANGE -1 PRECEDING) FROM emp;
SELECT ntile(0) OVER () FROM emp;
SELECT nth_value(id, 0) OVER () FROM emp;
SELECT count(DISTINCT id) OVER () FROM emp;
SELECT sum(id) OVER (ORDER BY id ROWS id PRECEDING) FROM emp;
