SELECT * FROM JSON_TABLE(jsonb '{"a": [{"x": 1, "y": "one"}, {"x": 2, "y": "two", "z": [1, 2]}, {"x": "bad"}]}', '$.a[*]' COLUMNS (x int PATH '$.x', y text PATH '$.y'));
SELECT * FROM JSON_TABLE(jsonb '{"a": [{"x": 1, "y": "one"}, {"x": 2, "y": "two", "z": [1, 2]}, {"x": "bad"}]}', '$.a[*]' COLUMNS (n FOR ORDINALITY, x int, y text));
SELECT x, z FROM JSON_TABLE(jsonb '{"a": [{"x": 1, "y": "one"}, {"x": 2, "y": "two", "z": [1, 2]}, {"x": "bad"}]}', '$.a[*]' COLUMNS (x int, z jsonb PATH '$.z'));
SELECT z, zt FROM JSON_TABLE(jsonb '{"a": [{"x": 1, "y": "one"}, {"x": 2, "y": "two", "z": [1, 2]}, {"x": "bad"}]}', '$.a[*]' COLUMNS (z text FORMAT JSON PATH '$.z', zt text PATH '$.z'))