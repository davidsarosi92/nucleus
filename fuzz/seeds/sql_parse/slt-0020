CREATE TABLE nums (n INT);
INSERT INTO nums WITH RECURSIVE s (n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 10) SELECT n FROM s;
SELECT count(*), sum(n) FROM (WITH big AS (SELECT n FROM nums WHERE n > 7) SELECT n FROM big) q;
WITH RECURSIVE r (n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < (SELECT count(*) FROM r)) SELECT * FROM r;
WITH a AS (SELECT 1), a AS (SELECT 2) SELECT 1;
WITH RECURSIVE r (n) AS (SELECT 1 UNION ALL SELECT n + 0.5 FROM r WHERE n < 3) SELECT * FROM r;
WITH t AS (SELECT * FROM nosuch) SELECT 1;
EXPLAIN WITH RECURSIVE n (i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 5) SELECT i FROM n;
