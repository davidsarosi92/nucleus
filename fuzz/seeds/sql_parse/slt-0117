SELECT id FROM pdocs WHERE doc @? '$.items[*] ? (@.qty > 1)' ORDER BY id;
SELECT id FROM pdocs WHERE doc @@ '$.age > 40' ORDER BY id;
SELECT id FROM pdocs WHERE doc @@ '$.items.size() == 0' ORDER BY id;
SELECT id, jsonb_path_query_array(doc, '$.items[*].sku') FROM pdocs ORDER BY id;
SELECT id, jsonb_path_query_first(doc, '$.items[*] ? (@.price > 10).sku') FROM pdocs ORDER BY id;
SELECT id, jsonb_path_exists(doc, '$.born ? (@.datetime() < "1985-01-01".datetime())') FROM pdocs ORDER BY id;
SELECT id, jsonb_path_match(doc, 'exists($.tags[*] ? (@ == "b"))') FROM pdocs ORDER BY id;
SELECT d.id, p.* FROM pdocs d, jsonb_path_query(d.doc, '$.items[*].qty') p ORDER BY d.id;
SELECT id, jsonb_path_query_first(doc, '$.items.price.sum()') FROM pdocs ORDER BY id;
