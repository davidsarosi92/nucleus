CREATE TABLE src (id INT PRIMARY KEY, name TEXT, score DOUBLE PRECISION);
INSERT INTO src VALUES (1, 'a', 0.5), (2, 'b', 1.5), (3, NULL, 2.5);
CREATE TABLE copy AS SELECT * FROM src WHERE id > 1;
SELECT id, name, score FROM copy ORDER BY id;
INSERT INTO copy VALUES ('x', 'y', 1);
CREATE TABLE named (k, label) AS SELECT id, upper(name), score * 2 AS score FROM src;
SELECT k, label, score FROM named ORDER BY k;
CREATE TABLE toomany (a, b, c, d) AS SELECT id FROM src;
CREATE TABLE empty AS SELECT id, name FROM src WITH NO DATA;
SELECT count(*) FROM empty;
