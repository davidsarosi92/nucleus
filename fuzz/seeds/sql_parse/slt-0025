CREATE TABLE loan (id INT PRIMARY KEY, book_id INT DEFAULT 0, reader TEXT, FOREIGN KEY (book_id) REFERENCES book ON DELETE SET DEFAULT);
CREATE TABLE note (id INT PRIMARY KEY, author_id INT, CONSTRAINT note_author FOREIGN KEY (author_id) REFERENCES author (id) ON DELETE SET NULL ON UPDATE CASCADE);
