CREATE TABLE ev_click PARTITION OF ev FOR VALUES IN ('click', 'tap') WITH (storage = column);
CREATE TABLE ev_view PARTITION OF ev FOR VALUES IN ('view');
INSERT INTO ev SELECT i, (ARRAY['click', 'tap', 'view'])[1 + i % 3] FROM generate_series(1, 3000) i;
CREATE INDEX ev_id ON ev (id);
SELECT kind, count(*) FROM ev GROUP BY kind ORDER BY kind;
SELECT kind FROM ev WHERE id = 7;
CREATE TABLE h (id INT PRIMARY KEY, x INT) PARTITION BY HASH (id);
CREATE TABLE h0 PARTITION OF h FOR VALUES WITH (MODULUS 3, REMAINDER 0);
CREATE TABLE h1 PARTITION OF h FOR VALUES WITH (MODULUS 3, REMAINDER 1);
CREATE TABLE h2 PARTITION OF h FOR VALUES WITH (MODULUS 3, REMAINDER 2);
INSERT INTO h SELECT i, i * 2 FROM generate_series(1, 900) i;
SELECT (SELECT count(*) FROM h), (SELECT count(*) FROM h0) BETWEEN 200 AND 400, (SELECT count(*) FROM h1) BETWEEN 200 AND 400, (SELECT count(*) FROM h2) BETWEEN 200 AND 400;
SELECT x FROM h WHERE id = 450;
ALTER TABLE h ADD COLUMN note TEXT DEFAULT 'n';
SELECT note, count(*) FROM h GROUP BY note;
ALTER TABLE h ALTER COLUMN x TYPE BIGINT;
DROP TABLE h;
SELECT * FROM h1;
CREATE TABLE pm (id INT, k INT, v TEXT, PRIMARY KEY (k, id)) PARTITION BY RANGE (k);
