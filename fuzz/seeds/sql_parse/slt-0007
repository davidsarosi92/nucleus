SELECT id FROM few WHERE EXISTS (SELECT 1 FROM many WHERE many.k = few.k AND many.v < few.lim);
SELECT id FROM few WHERE NOT EXISTS (SELECT 1 FROM many WHERE many.k = few.k AND many.v < few.lim);
SELECT id FROM few WHERE k IN (SELECT k FROM many);
