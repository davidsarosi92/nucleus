# Types of expressions, through pg_typeof: integer widths and their
# promotion (crates/testkit/slt/23_integers.slt has the values).
# Expected results produced by PostgreSQL 18.

statement ok
CREATE TABLE widths (id integer PRIMARY KEY, s smallint, b bigint)

statement ok
INSERT INTO widths VALUES (1, 32767, 9223372036854775807), (2, -32768, -9223372036854775808), (3, 0, 0), (4, -1, 12)

query TTT
SELECT pg_typeof(1), pg_typeof(2147483648), pg_typeof(1::smallint)
----
integer bigint smallint

query TTTT
SELECT pg_typeof(1::smallint + 1::smallint), pg_typeof(1::smallint + 1), pg_typeof(1 + 1::bigint), pg_typeof(1::smallint * 1.5)
----
smallint integer bigint numeric

query TTT
SELECT pg_typeof(s), pg_typeof(s + s), pg_typeof(s + id) FROM widths WHERE id = 3
----
smallint smallint integer

query TTTT
SELECT pg_typeof(sum(s)), pg_typeof(sum(id)), pg_typeof(avg(s)), pg_typeof(min(s)) FROM widths
----
bigint bigint numeric smallint

query TT
SELECT pg_typeof(length('abc')), pg_typeof(abs(1::smallint))
----
integer smallint

query T
SELECT pg_typeof(ARRAY[1::smallint, 2])
----
integer[]

query T
SELECT pg_typeof(CASE WHEN true THEN 1::smallint ELSE 2::bigint END)
----
bigint

query T
SELECT pg_typeof(x) FROM (SELECT 1::smallint UNION SELECT 2) t(x) LIMIT 1
----
integer

query T
SELECT pg_typeof(date '2024-01-02' - date '2024-01-01')
----
integer

statement ok
DROP TABLE widths

# real beside double precision.

query TTTT
SELECT pg_typeof(1::real + 1::real), pg_typeof(1::real + 1), pg_typeof(1::real + 1.5), pg_typeof(1::real * 1::float8)
----
real double precision double precision double precision

query TT
SELECT pg_typeof(sum(x)), pg_typeof(avg(x)) FROM (VALUES (1.5::real)) v (x)
----
real double precision

query TT
SELECT pg_typeof(abs(1.5::real)), pg_typeof(floor(1.5::real))
----
real double precision

query TT
SELECT pg_typeof(greatest(1::real, 2)), pg_typeof(CASE WHEN true THEN 1::real ELSE 2.5 END)
----
real real

# bytea.

query TTTT
SELECT pg_typeof('\x01'::bytea), pg_typeof('\x01'::bytea || '\x02'), pg_typeof(md5('a')), pg_typeof(sha256('a'))
----
bytea bytea text bytea

query TTT
SELECT pg_typeof(length('\x01'::bytea)), pg_typeof(substring('\x0102'::bytea from 2)), pg_typeof(encode('\x01'::bytea, 'hex'))
----
integer bytea text

# time.

query TTTT
SELECT pg_typeof(time '10:00'), pg_typeof(time '10:00' - time '09:00'), pg_typeof(date '2024-01-01' + time '10:00'), pg_typeof(localtime)
----
time without time zone interval timestamp without time zone time without time zone

# char(n).

query TTT
SELECT pg_typeof('a'::char(3)), pg_typeof('a'::char(3) || 'b'), pg_typeof(CASE WHEN true THEN 'a'::char(2) ELSE 'b'::text END)
----
character text text

statement ok
CREATE TABLE chars (c char(4), v varchar(4))

query TT
SELECT format_type(atttypid, atttypmod), attname FROM pg_attribute WHERE attrelid = 'chars'::regclass AND attnum > 0 ORDER BY attnum
----
character(4) c
character varying(4) v

statement ok
DROP TABLE chars

# inet and cidr.

query TTTT
SELECT pg_typeof('10.1.2.3'::inet), pg_typeof(network('10.1.2.3/8'::inet)), pg_typeof(masklen('10/8'::cidr)), pg_typeof(CASE WHEN true THEN '10/8'::cidr ELSE '10.1.2.3'::inet END)
----
inet cidr integer inet

# Enums.

statement ok
CREATE TYPE pg_mood AS ENUM ('sad', 'happy')

statement ok
CREATE TABLE pg_feel (who text, m pg_mood)

statement ok
INSERT INTO pg_feel VALUES ('a', 'happy'), ('b', 'sad')

query TTT
SELECT who, m, pg_typeof(m) FROM pg_feel ORDER BY m
----
b sad pg_mood
a happy pg_mood

statement ok
DROP TABLE pg_feel

statement ok
DROP TYPE pg_mood
