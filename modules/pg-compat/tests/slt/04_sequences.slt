# Sequences in PostgreSQL's catalogs (issue #23): pg_class (relkind S),
# pg_sequence, pg_sequences, information_schema.sequences, regclass.
# Checked against PostgreSQL 18 (scripts/slt-pg.py).

statement ok
CREATE SEQUENCE cat_s AS integer INCREMENT BY 3 MAXVALUE 1000 CYCLE

statement ok
CREATE TABLE cat_t (id bigserial, v text)

query TTTIIIIBI
SELECT sequencename, data_type::text, sequenceowner = current_user, start_value, min_value, max_value, increment_by, cycle, cache_size FROM pg_sequences WHERE sequencename IN ('cat_s', 'cat_t_id_seq') ORDER BY 1
----
cat_s integer t 1 1 1000 3 true 1
cat_t_id_seq bigint t 1 1 9223372036854775807 1 false 1

query I
SELECT last_value FROM pg_sequences WHERE sequencename = 'cat_s'
----
NULL

statement ok
SELECT nextval('cat_s')

query I
SELECT last_value FROM pg_sequences WHERE sequencename = 'cat_s'
----
1

query TT
SELECT relname, relkind FROM pg_class WHERE relname IN ('cat_s', 'cat_t_id_seq', 'cat_t') ORDER BY relname
----
cat_s S
cat_t r
cat_t_id_seq S

query TTIIIIB
SELECT s.seqrelid::regclass::text, s.seqtypid::regtype::text, s.seqstart, s.seqincrement, s.seqmax, s.seqmin, s.seqcycle FROM pg_sequence s JOIN pg_class c ON c.oid = s.seqrelid WHERE c.relname = 'cat_s'
----
cat_s integer 1 3 1000 1 true

query TTTTTTT
SELECT sequence_name, data_type, start_value, minimum_value, maximum_value, increment, cycle_option FROM information_schema.sequences WHERE sequence_name IN ('cat_s', 'cat_t_id_seq') ORDER BY 1
----
cat_s integer 1 1 1000 3 YES
cat_t_id_seq bigint 1 1 9223372036854775807 1 NO

query TT
SELECT relname, relkind FROM pg_class WHERE oid = 'cat_s'::regclass
----
cat_s S

# A sequence a column owns: its dependency (psql's \d reads it)
query TTIT
SELECT c.relname, t.relname, d.refobjsubid, d.deptype FROM pg_depend d JOIN pg_class c ON c.oid = d.objid JOIN pg_class t ON t.oid = d.refobjid WHERE c.relname = 'cat_t_id_seq'
----
cat_t_id_seq cat_t 1 a

# psql's \d sequence: the owner by pg_class's oid, an identity's too
statement ok
CREATE TABLE cat_i (id int GENERATED ALWAYS AS IDENTITY)

query TTIT
SELECT c.relname, t.relname, d.refobjsubid, d.deptype FROM pg_depend d JOIN pg_class c ON c.oid = d.objid JOIN pg_class t ON t.oid = d.refobjid WHERE d.classid = 'pg_catalog.pg_class'::pg_catalog.regclass AND d.refclassid = 'pg_catalog.pg_class'::pg_catalog.regclass AND d.deptype IN ('a', 'i') AND c.relname IN ('cat_t_id_seq', 'cat_i_id_seq') ORDER BY 1
----
cat_i_id_seq cat_i 1 i
cat_t_id_seq cat_t 1 a

statement ok
DROP TABLE cat_i

statement ok
DROP TABLE cat_t

statement ok
DROP SEQUENCE cat_s
